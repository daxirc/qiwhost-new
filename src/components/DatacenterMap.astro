---
---

<section class="py-16 md:py-24 bg-gray-50">
  <div class="container">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-16">Global Infrastructure Presence</h2>
      
      <!-- Map Container -->
      <div class="relative bg-white rounded-xl shadow-lg p-8 mb-8">
        <!-- 8 Regions Circle -->
        <div class="absolute top-4 right-4 md:top-6 md:right-6 bg-primary-600 text-white rounded-full w-20 h-20 md:w-24 md:h-24 flex flex-col items-center justify-center shadow-lg z-10">
          <span class="text-xl md:text-2xl font-bold">8</span>
          <span class="text-xs md:text-sm">regions</span>
        </div>
        
        <!-- World Map -->
        <div class="relative mx-auto max-w-4xl">
          <img 
            src="/index-node-map-bg.png" 
            alt="Global Datacenter Map" 
            class="w-full h-auto rounded-lg"
            loading="lazy"
            width="800"
            height="400"
          />
          
          <!-- Datacenter Markers -->
          <div class="absolute inset-0">
            <!-- North America - USA -->
            <div class="absolute top-[40%] left-[22%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-4 h-4 bg-blue-500 rounded-full shadow-lg animate-pulse border-2 border-white"></div>
              <div class="absolute top-6 left-1/2 transform -translate-x-1/2 text-xs font-medium text-gray-700 whitespace-nowrap bg-white px-2 py-1 rounded shadow">USA</div>
            </div>
            
            <!-- Europe - Germany -->
            <div class="absolute top-[35%] left-[52%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-4 h-4 bg-blue-500 rounded-full shadow-lg animate-pulse border-2 border-white" style="animation-delay: 0.2s;"></div>
              <div class="absolute top-6 left-1/2 transform -translate-x-1/2 text-xs font-medium text-gray-700 whitespace-nowrap bg-white px-2 py-1 rounded shadow">Germany</div>
            </div>
            
            <!-- Europe - UK -->
            <div class="absolute top-[32%] left-[49%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-4 h-4 bg-blue-500 rounded-full shadow-lg animate-pulse border-2 border-white" style="animation-delay: 0.4s;"></div>
              <div class="absolute top-6 left-1/2 transform -translate-x-1/2 text-xs font-medium text-gray-700 whitespace-nowrap bg-white px-2 py-1 rounded shadow">UK</div>
            </div>
            
            <!-- Europe - Finland -->
            <div class="absolute top-[28%] left-[55%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-4 h-4 bg-blue-500 rounded-full shadow-lg animate-pulse border-2 border-white" style="animation-delay: 0.6s;"></div>
              <div class="absolute top-6 left-1/2 transform -translate-x-1/2 text-xs font-medium text-gray-700 whitespace-nowrap bg-white px-2 py-1 rounded shadow">Finland</div>
            </div>
            
            <!-- Asia Pacific - Singapore -->
            <div class="absolute top-[58%] left-[72%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-4 h-4 bg-blue-500 rounded-full shadow-lg animate-pulse border-2 border-white" style="animation-delay: 0.8s;"></div>
              <div class="absolute top-6 left-1/2 transform -translate-x-1/2 text-xs font-medium text-gray-700 whitespace-nowrap bg-white px-2 py-1 rounded shadow">Singapore</div>
            </div>
            
            <!-- Additional markers for visual balance -->
            <div class="absolute top-[45%] left-[18%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-3 h-3 bg-blue-400 rounded-full shadow animate-pulse border border-white" style="animation-delay: 1s;"></div>
            </div>
            
            <div class="absolute top-[65%] left-[78%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-3 h-3 bg-blue-400 rounded-full shadow animate-pulse border border-white" style="animation-delay: 1.2s;"></div>
            </div>
            
            <div class="absolute top-[38%] left-[58%] transform -translate-x-1/2 -translate-y-1/2">
              <div class="w-3 h-3 bg-blue-400 rounded-full shadow animate-pulse border border-white" style="animation-delay: 1.4s;"></div>
            </div>
          </div>
        </div>
        
        <!-- Location Labels -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 text-sm text-gray-600">
          <div class="flex items-center justify-center">
            <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
            <span>North America</span>
          </div>
          <div class="flex items-center justify-center">
            <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
            <span>Europe</span>
          </div>
          <div class="flex items-center justify-center">
            <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
            <span>Asia Pacific</span>
          </div>
          <div class="flex items-center justify-center">
            <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
            <span>Global Network</span>
          </div>
        </div>
      </div>
      
      <!-- CTA Button -->
      <div class="text-center">
        <a 
          href="/about" 
          class="inline-flex items-center px-8 py-3 border border-primary-600 text-primary-600 rounded-lg hover:bg-primary-50 transition-colors duration-200 font-medium"
        >
          <i class="fas fa-globe mr-2"></i>
          Explore regions
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.2);
    }
  }
  
  .animate-pulse {
    animation: pulse 2s infinite;
  }
</style>