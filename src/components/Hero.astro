---
interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  backgroundClass?: string;
  showFeatureBadges?: boolean;
}

const { 
  title, 
  subtitle, 
  ctaText = "Get Started", 
  ctaLink = "/pricing", 
  secondaryCtaText,
  secondaryCtaLink,
  backgroundClass = "bg-gradient-to-r from-primary-600 to-primary-800",
  showFeatureBadges = false
} = Astro.props;
---

<section class="relative min-h-[600px] flex items-center overflow-hidden">
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.pexels.com/photos/325229/pexels-photo-325229.jpeg" 
      alt="Data Center Background" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900/95 to-gray-900/80"></div>
  </div>

  <!-- Content -->
  <div class="container relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Title & Subtitle -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 animate-fade-in">
        {title}
      </h1>
      <p class="text-xl md:text-2xl text-gray-200 mb-8 animate-slide-up">
        {subtitle}
      </p>

      <!-- Feature Badges -->
      {showFeatureBadges && (
        <div class="flex flex-wrap justify-center gap-4 mb-8 animate-slide-up">
          <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-white">
            <i class="fas fa-shield-alt mr-2"></i>
            <span>Full Root Access</span>
          </div>
          <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-white">
            <i class="fas fa-microchip mr-2"></i>
            <span>Intel Xeon & AMD EPYC</span>
          </div>
          <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-white">
            <i class="fas fa-lock mr-2"></i>
            <span>DDoS Protection</span>
          </div>
        </div>
      )}

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 animate-slide-up">
        <a 
          href={ctaLink} 
          class="inline-flex items-center justify-center px-8 py-4 rounded-lg bg-white text-primary-600 font-medium hover:bg-gray-100 transition-all duration-200 transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          {ctaText}
          <i class="fas fa-arrow-right ml-2"></i>
        </a>
        {secondaryCtaText && secondaryCtaLink && (
          <a 
            href={secondaryCtaLink} 
            class="inline-flex items-center justify-center px-8 py-4 rounded-lg border-2 border-white text-white font-medium hover:bg-white/10 transition-all duration-200"
          >
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Decorative Elements -->
  <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-gray-900 to-transparent z-[1]"></div>
  <div class="absolute -bottom-1 -left-4 w-72 h-72 bg-primary-500/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-1 -right-4 w-72 h-72 bg-primary-600/20 rounded-full blur-3xl"></div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 1s ease forwards;
  }

  .animate-slide-up {
    animation: slideUp 0.6s ease forwards;
  }
</style>