---
import { fetchBlogPosts } from '../lib/api';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Fetch recent posts from VPS API at build time
const allPosts = await fetchBlogPosts();
const recentPosts = allPosts.slice(0, 5);

// Popular categories (for future implementation)
const categories = [
  { name: 'VPS Hosting', count: 5, slug: 'vps-hosting' },
  { name: 'Dedicated Servers', count: 3, slug: 'dedicated-servers' },
  { name: 'RDP Solutions', count: 4, slug: 'rdp-solutions' },
  { name: 'Tutorials', count: 7, slug: 'tutorials' },
  { name: 'News', count: 2, slug: 'news' }
];

const currentLocale = Astro.currentLocale || 'en';
---

<div class="space-y-8">
  <!-- Recent Posts -->
  <div>
    <h3 class="text-xl font-bold text-gray-900 mb-4">Recent Posts</h3>
    {recentPosts && recentPosts.length > 0 ? (
      <ul class="space-y-4">
        {recentPosts.map(post => (
          <li>
            <a href={getRelativeLocaleUrl(currentLocale, `/blog/${post.slug}`)} class="flex items-start group">
              <i class="fas fa-angle-right text-primary-500 mt-1 mr-2 group-hover:text-primary-600"></i>
              <span class="text-gray-700 group-hover:text-primary-600 transition-colors">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-gray-500 italic">No recent posts available</p>
    )}
  </div>

  <!-- Categories (for future implementation) -->
  <div>
    <h3 class="text-xl font-bold text-gray-900 mb-4">Categories</h3>
    <ul class="space-y-2">
      {categories.map(category => (
        <li>
          <a href={getRelativeLocaleUrl(currentLocale, `/blog/category/${category.slug}`)} class="flex items-center justify-between group">
            <span class="text-gray-700 group-hover:text-primary-600 transition-colors">{category.name}</span>
            <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded-full">{category.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Newsletter Signup -->
  <div class="bg-primary-50 p-6 rounded-xl border border-primary-100">
    <h3 class="text-xl font-bold text-gray-900 mb-2">Subscribe to Our Newsletter</h3>
    <p class="text-gray-600 mb-4">Get the latest hosting tips and news delivered to your inbox.</p>
    <form class="space-y-3">
      <input 
        type="email" 
        placeholder="Your email address" 
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
        required
      />
      <button 
        type="submit"
        class="w-full bg-primary-600 text-white py-2 px-4 rounded-lg hover:bg-primary-700 transition-colors font-medium"
      >
        Subscribe
      </button>
    </form>
  </div>
</div>