---
import { format } from 'date-fns';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  slug: string;
  description: string;
  featuredImage: string;
  publishedAt: string;
}

const { title, slug, description, featuredImage, publishedAt } = Astro.props;

// Format the published date
const formattedDate = publishedAt 
  ? format(new Date(publishedAt), 'MMMM d, yyyy')
  : null;

// Create excerpt from description
function createExcerpt(text, maxLength = 150) {
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + '...';
}

const excerpt = createExcerpt(description);

const currentLocale = Astro.currentLocale || 'en';
---

<article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
  <a href={getRelativeLocaleUrl(currentLocale, `/blog/${slug}`)} class="block">
    <div class="h-48 overflow-hidden">
      <img 
        src={featuredImage} 
        alt={title} 
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
        loading="lazy"
      />
    </div>
  </a>
  <div class="p-6">
    <div class="text-sm text-gray-500 mb-2">
      {formattedDate && (
        <time datetime={publishedAt}>
          {formattedDate}
        </time>
      )}
    </div>
    <h2 class="text-xl font-bold text-gray-900 mb-3 hover:text-primary-600 transition-colors">
      <a href={getRelativeLocaleUrl(currentLocale, `/blog/${slug}`)}>{title}</a>
    </h2>
    <p class="text-gray-600 mb-4">
      {excerpt}
    </p>
    <a 
      href={getRelativeLocaleUrl(currentLocale, `/blog/${slug}`)} 
      class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium"
    >
      Read More
      <i class="fas fa-arrow-right ml-2 text-sm"></i>
    </a>
  </div>
</article>