---
  // Navigation bar component
import { supabase } from '../lib/supabase';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslations, getCurrentLocale, getFlagImageUrl } from '../i18n/utils';

// Get translations for current locale
const locale = getCurrentLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Fetch VPS locations for the dropdown
const { data: vpsLocations, error } = await supabase
  .from('hosting_plans')
  .select('region, location, flag_icon')
  .eq('category', 'VPS')
  .eq('visible', true)
  .not('region', 'is', null)
  .not('location', 'is', null)
  .order('region', { ascending: true })
  .order('location', { ascending: true });

console.log('Fetched VPS Locations:', vpsLocations);

// Define countries that should be excluded from the locations dropdown
const cloudVpsCountries = ['Germany', 'Finland', 'USA', 'UK', 'Singapore', 'Japan', 'India', 'Australia'];

// Filter out countries that have dedicated pages
const filteredLocations = vpsLocations?.filter(location => !cloudVpsCountries.includes(location.location)) || [];

// Group locations by region
const locationsByRegion = {};
if (filteredLocations && !error) {
  filteredLocations.forEach(location => {
    if (!locationsByRegion[location.region]) {
      locationsByRegion[location.region] = [];
    }
    // Avoid duplicates
    const exists = locationsByRegion[location.region].find(
      loc => loc.location === location.location
    );
    if (!exists) {
      locationsByRegion[location.region].push({
        location: location.location,
        flag_icon: location.flag_icon,
        slug: location.location.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '')
      });
    }
  });
}

console.log('Grouped Locations by Region:', locationsByRegion);

function slugify(text) {
  return text.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
}

// Get current locale for generating locale-aware URLs
const currentLocale = Astro.currentLocale || 'en';
