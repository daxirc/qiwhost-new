      <details class="group">
        <summary class="flex items-center justify-between cursor-pointer py-2 text-gray-700 hover:text-primary-600">
          <div class="flex items-center">
            <i class="fas fa-map-marker-alt mr-2 text-primary-500"></i>
            <span class="font-medium">Locations</span>
          </div>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="ml-6 mt-2 space-y-3">
          {Object.keys(locationsByRegion).map(region => (
            <details class="group/region">
              <summary class="flex items-center justify-between cursor-pointer py-1 text-sm text-gray-600 hover:text-primary-600">
                <span class="font-medium">{region}</span>
                <svg class="w-3 h-3 transition-transform group-open/region:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="ml-4 mt-1 space-y-1">
                {locationsByRegion[region] && locationsByRegion[region].length > 0 ? (
                  locationsByRegion[region].map(location => (
                    <a 
                      href={getRelativeLocaleUrl(currentLocale, `/vps/locations/${location.slug}`)}
                      class="flex items-center text-xs text-gray-700 hover:underline py-1"
                    >
                      <img 
                        src={getFlagImageUrl(location.flag_icon)} 
                        width="16" 
                        alt={`${location.location} Flag`} 
                        class="flag-icon mr-2"
                      />
                      <span>{location.location} VPS</span>
                    </a>
                  ))
                ) : (
                  <span class="text-xs text-gray-500 italic">Coming Soon</span>
                )}
              </div>
            </details>
          ))}
        </div>
      </details>

      <a href="https://portal.qiwhost.com/login" class="block mt-4 text-center bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700">
        <i class="far fa-user-circle mr-2"></i> Client Area
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('mobile-menu-open');
    });
  });
</script>