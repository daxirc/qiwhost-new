---
---

<section class="w-full py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
      <!-- Left Side: Dashboard Illustration (35% width) -->
      <div class="lg:col-span-2 relative flex justify-center lg:justify-start">
        <div class="bg-gray-50 rounded-2xl p-6 shadow-lg max-w-sm w-full">
          <!-- Monitor Frame -->
          <div class="bg-gray-800 rounded-lg p-3 shadow-xl">
            <!-- Monitor Screen -->
            <div class="bg-white rounded-md p-4 min-h-[280px] relative overflow-hidden">
              <!-- Header Bar -->
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-200">
                <div class="flex items-center space-x-2">
                  <div class="w-6 h-6 bg-primary-600 rounded-md flex items-center justify-center">
                    <i class="fas fa-server text-white text-xs"></i>
                  </div>
                  <h3 class="text-sm font-semibold text-gray-900">Dashboard</h3>
                </div>
                <div class="flex space-x-1">
                  <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                  <div class="w-2 h-2 bg-yellow-500 rounded-full"></div>
                  <div class="w-2 h-2 bg-red-500 rounded-full"></div>
                </div>
              </div>
              
              <!-- Server Stats Cards -->
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div class="bg-blue-50 rounded-lg p-3">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-xs text-gray-600">CPU</p>
                      <p class="text-sm font-bold text-blue-600">23%</p>
                    </div>
                    <i class="fas fa-microchip text-blue-500 text-sm"></i>
                  </div>
                  <div class="w-full bg-blue-200 rounded-full h-1.5 mt-1">
                    <div class="bg-blue-600 h-1.5 rounded-full" style="width: 23%"></div>
                  </div>
                </div>
                
                <div class="bg-green-50 rounded-lg p-3">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-xs text-gray-600">RAM</p>
                      <p class="text-sm font-bold text-green-600">67%</p>
                    </div>
                    <i class="fas fa-memory text-green-500 text-sm"></i>
                  </div>
                  <div class="w-full bg-green-200 rounded-full h-1.5 mt-1">
                    <div class="bg-green-600 h-1.5 rounded-full" style="width: 67%"></div>
                  </div>
                </div>
              </div>
              
              <!-- Quick Actions -->
              <div class="space-y-2">
                <div class="flex items-center justify-between p-2 bg-gray-50 rounded-md">
                  <div class="flex items-center space-x-2">
                    <div class="w-5 h-5 bg-primary-100 rounded-full flex items-center justify-center">
                      <i class="fas fa-power-off text-primary-600 text-xs"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-700">Status</span>
                  </div>
                  <span class="px-2 py-0.5 bg-green-100 text-green-800 text-xs font-medium rounded-full">Online</span>
                </div>
                
                <div class="flex items-center justify-between p-2 bg-gray-50 rounded-md">
                  <div class="flex items-center space-x-2">
                    <div class="w-5 h-5 bg-blue-100 rounded-full flex items-center justify-center">
                      <i class="fas fa-chart-line text-blue-600 text-xs"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-700">Traffic</span>
                  </div>
                  <span class="text-xs text-gray-600">1.2 GB</span>
                </div>
                
                <div class="flex items-center justify-between p-2 bg-gray-50 rounded-md">
                  <div class="flex items-center space-x-2">
                    <div class="w-5 h-5 bg-purple-100 rounded-full flex items-center justify-center">
                      <i class="fas fa-hdd text-purple-600 text-xs"></i>
                    </div>
                    <span class="text-xs font-medium text-gray-700">Storage</span>
                  </div>
                  <span class="text-xs text-gray-600">45%</span>
                </div>
              </div>
              
              <!-- Floating Action Button -->
              <div class="absolute bottom-3 right-3">
                <div class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center shadow-lg">
                  <i class="fas fa-cog text-white text-xs"></i>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Monitor Stand -->
          <div class="flex justify-center mt-3">
            <div class="w-12 h-6 bg-gray-700 rounded-b-lg"></div>
          </div>
          <div class="flex justify-center">
            <div class="w-16 h-2 bg-gray-600 rounded-full"></div>
          </div>
        </div>
        
        <!-- Decorative Elements -->
        <div class="absolute -top-3 -right-3 w-12 h-12 bg-primary-100 rounded-full opacity-50"></div>
        <div class="absolute -bottom-4 -left-4 w-10 h-10 bg-blue-100 rounded-full opacity-50"></div>
      </div>
      
      <!-- Right Side: Content (65% width) -->
      <div class="lg:col-span-3 space-y-8">
        <!-- Heading and Description -->
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Manage Your Infrastructure
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            Control your servers, monitor performance, and manage billing & support — all from one intuitive dashboard.
          </p>
        </div>
        
        <!-- Feature Icons Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <!-- Row 1 -->
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">🔁</span>
            </div>
            <span class="text-sm font-medium text-gray-700">Server Reboot</span>
          </div>
          
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">💾</span>
            </div>
            <span class="text-sm font-medium text-gray-700">OS Reinstallation</span>
          </div>
          
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">🔐</span>
            </div>
            <span class="text-sm font-medium text-gray-700">SSH Keys</span>
          </div>
          
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">🖥️</span>
            </div>
            <span class="text-sm font-medium text-gray-700">VNC Access</span>
          </div>
          
          <!-- Row 2 -->
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">🌍</span>
            </div>
            <span class="text-sm font-medium text-gray-700">Switch Location</span>
          </div>
          
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">📊</span>
            </div>
            <span class="text-sm font-medium text-gray-700">Network Usage</span>
          </div>
          
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">🧭</span>
            </div>
            <span class="text-sm font-medium text-gray-700">Change Boot Order</span>
          </div>
          
          <div class="flex flex-col items-center text-center space-y-3 p-4 rounded-lg hover:bg-gray-50 transition-colors duration-200">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <span class="text-xl">📈</span>
            </div>
            <span class="text-sm font-medium text-gray-700">Traffic Graphs</span>
          </div>
        </div>
        
        <!-- CTA Button -->
        <div class="pt-4">
          <a 
            href="/clientarea" 
            class="inline-flex items-center px-8 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors duration-200 font-medium shadow-lg hover:shadow-xl"
          >
            <i class="fas fa-tachometer-alt mr-2"></i>
            Access Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</section>