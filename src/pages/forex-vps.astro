    ],
    ctaText: "Launch Now",
    ctaLink: "https://portal.qiwhost.com/cart.php?a=add&pid=163"
  },
  {
    name: "Pro",
    description: "Ideal For 3-4 Terminals",
    price: "22.99",
    features: [
      "4 vCore CPU",
      "8 GB RAM",
      "80 GB SSD Storage",
      "20 TB Bandwidth",
      "Windows Server (OS)",
      "Install Any Application and Program",
      "Multiple VPS Locations"
    ],
    ctaText: "Launch Now",
    ctaLink: "https://portal.qiwhost.com/cart.php?a=add&pid=164"
  },
  {
    name: "Elite",
    description: "Ideal For 4-6 Terminals",
    price: "39.99",
    features: [
      "8 vCore CPU",
      "16 GB RAM",
      "160 GB SSD Storage",
      "20 TB Bandwidth",
      "Windows Server (OS)",
      "Install Any Application and Program",
      "Multiple VPS Locations"
    ],
    ctaText: "Launch Now",
    ctaLink: "https://portal.qiwhost.com/cart.php?a=add&pid=165",
    popular: true
  },
  {
    name: "Advanced",
    description: "Ideal For 6+ Terminals",
    price: "69.99",
    features: [
      "16 vCore CPU",
      "32 GB RAM",
      "320 GB SSD Storage",
      "20 TB Bandwidth",
      "Windows Server (OS)",
      "Install Any Application and Program",
      "Multiple VPS Locations"
    ],
    ctaText: "Launch Now",
    ctaLink: "https://portal.qiwhost.com/cart.php?a=add&pid=166"
  }
