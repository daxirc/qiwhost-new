---
import Layout from '../../../layouts/MainLayout.astro';
import Hero from '../../../components/Hero.astro';
import UsaRdpPricing from '../../../components/UsaRdpPricing.astro';
import CTABanner from '../../../components/CTABanner.astro';
import FeaturesSection from '../../../components/FeaturesSection.astro';
import { getTranslations, getCurrentLocale } from '../../../i18n/utils';

// Get translations for current locale
const locale = getCurrentLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Flag emoji to country code mapping
const flagEmojiToCountryCode = {
  '🇺🇸': 'us'
};

function getFlagImageUrl(flagEmoji) {
  const countryCode = flagEmojiToCountryCode[flagEmoji];
  return countryCode ? `https://flagcdn.com/${countryCode}.svg` : null;
}

// Country-specific information
const country = {
  name: "USA",
  flag: "🇺🇸",
  countryCode: "us",
  locations: ["New York", "Dallas", "Los Angeles"],
  ping: "< 40ms from North America"
};

// Features data with translations
const features = [
  {
    title: "100% Resource Isolation",
    description: "Dedicated CPU, RAM, and storage resources that are never shared or oversold.",
    icon: "fas fa-layer-group"
  },
  {
    title: "Administrator Access",
    description: "Full administrator privileges to install software and customize your environment.",
    icon: "fas fa-user-shield"
  },
  {
    title: "SSD Storage",
    description: "Fast SSD storage for improved application performance and responsiveness.",
    icon: "fas fa-hdd"
  },
  {
    title: "99.9% Uptime Guarantee",
    description: "Our infrastructure ensures your RDP service remains accessible and reliable.",
    icon: "fas fa-chart-line"
  },
  {
    title: "Secure Connection",
    description: "Enterprise-grade encryption and security measures to protect your data.",
    icon: "fas fa-lock"
  },
  {
    title: "24/7 Support",
    description: "Technical assistance available around the clock to help with any issues.",
    icon: "fas fa-headset"
  }
];

// Use cases with translations
const useCases = [
  {
    title: t.rdp.common.useCases.remoteWork.title,
    description: t.rdp.common.useCases.remoteWork.description,
    icon: "fas fa-laptop-house"
  },
  {
    title: t.rdp.common.useCases.development.title,
    description: t.rdp.common.useCases.development.description,
    icon: "fas fa-code"
  },
  {
    title: t.rdp.common.useCases.business.title,
    description: t.rdp.common.useCases.business.description,
    icon: "fas fa-briefcase"
  },
  {
    title: t.rdp.common.useCases.content.title,
    description: t.rdp.common.useCases.content.description,
    icon: "fas fa-photo-video"
  }
];

const flagImageUrl = getFlagImageUrl(country.flag);

// Create translated strings with country name replacement
const pricingTitle = t.rdp.common.pricing.title.replace('{country}', country.name);
const overviewTitle = t.rdp.common.overview.title.replace('{country}', country.name);
const overviewDescription1 = t.rdp.common.overview.description1.replace('{country}', country.name);
const overviewDescription2 = t.rdp.common.overview.description2;
const strategicLocationsTitle = t.rdp.common.overview.strategicLocations.title.replace('{country}', country.name);
const strategicLocationsDescription = t.rdp.common.overview.strategicLocations.description.replace('{country}', country.name);
const useCasesSubtitle = t.rdp.common.useCases.subtitle.replace('{country}', country.name);
const ctaTitle = t.rdp.common.cta.title.replace('{country}', country.name);
const locationsText = t.rdp.common.locations.locations.replace('{locations}', country.locations.join(", "));
const pingText = t.rdp.common.locations.ping.replace('{ping}', country.ping);
---

<Layout 
  title="Acheter RDP USA – Configuration Instantanée et Accès Admin" 
  description="Obtenez un RDP USA rapide et sécurisé avec accès administrateur complet, IP dédiée et stockage SSD. Hébergé à New York, Dallas et Los Angeles. Déploiement instantané."
>
  <!-- Hero Section -->
  <Hero
    title={t.rdp.usa.hero.title}
    subtitle={t.rdp.usa.hero.subtitle}
    ctaText="View Pricing"
    ctaLink="#pricing"
    backgroundClass="bg-gradient-to-r from-primary-700 to-primary-900"
  />

  <!-- Locations -->
  <section class="py-8 bg-white border-b">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-center items-center gap-8 md:gap-16">
        <div class="flex items-center">
          <i class="fas fa-map-marker-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{locationsText}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-tachometer-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{pingText}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-shield-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.rdp.common.locations.enterpriseSecurity}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Table -->
  <div id="pricing">
    <UsaRdpPricing
      title={pricingTitle}
      description={t.rdp.common.pricing.description}
    />
  </div>

  <!-- RDP Overview -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            {flagImageUrl ? (
              <span>
                <img src={flagImageUrl} width="30" alt={`${country.name} Flag`} class="flag-icon inline mr-3" />
                {overviewTitle}
              </span>
            ) : (
              `${country.flag} ${overviewTitle}`
            )}
          </h2>
          <p class="text-lg text-gray-700 mb-6">
            {overviewDescription1}
          </p>
          <p class="text-lg text-gray-700 mb-6">
            {overviewDescription2}
          </p>
          
          <div class="mt-8 space-y-4">
            <div class="flex items-start">
              <div class="bg-primary-100 rounded-full p-2 mt-1 mr-4">
                <i class="fas fa-check text-primary-600"></i>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-1">{strategicLocationsTitle}</h3>
                <p class="text-gray-600">{strategicLocationsDescription}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-primary-100 rounded-full p-2 mt-1 mr-4">
                <i class="fas fa-check text-primary-600"></i>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-1">{t.rdp.common.overview.lowLatency.title}</h3>
                <p class="text-gray-600">{t.rdp.common.overview.lowLatency.description}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-primary-100 rounded-full p-2 mt-1 mr-4">
                <i class="fas fa-check text-primary-600"></i>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-1">{t.rdp.common.overview.instantProvisioning.title}</h3>
                <p class="text-gray-600">{t.rdp.common.overview.instantProvisioning.description}</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="relative">
          <img src="https://images.pexels.com/photos/1181467/pexels-photo-1181467.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="USA Private RDP" class="rounded-xl shadow-xl" />
          <div class="absolute -bottom-6 -right-6 bg-primary-600 text-white p-4 rounded-lg shadow-lg">
            {flagImageUrl ? (
              <img src={flagImageUrl} width="30" alt={`${country.name} Flag`} class="flag-icon" />
            ) : (
              <span class="text-3xl">{country.flag}</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{t.rdp.common.useCases.title}</h2>
        <p class="text-xl text-gray-600">
          {useCasesSubtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {useCases.map(useCase => (
          <div class="bg-white p-6 rounded-xl shadow-md text-center">
            <div class="bg-primary-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
              <i class={`${useCase.icon} text-primary-600 text-2xl`}></i>
            </div>
            <h3 class="text-xl font-semibold mb-3">{useCase.title}</h3>
            <p class="text-gray-600">{useCase.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title={ctaTitle}
    subtitle={t.rdp.common.cta.subtitle}
    ctaText="Order Now"
    ctaLink="https://portal.qiwhost.com/login"
  />
</Layout>
