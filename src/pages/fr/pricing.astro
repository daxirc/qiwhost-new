  {
    name: "Basic Server",
    price: {
      monthly: "$99.99",
      yearly: "$89.99"
    },
    description: "Entry-level dedicated server for growing businesses",
    features: [
      "Intel Xeon E-2276G",
      "32GB DDR4 RAM",
      "2x 512GB SSD",
      "10TB Bandwidth",
