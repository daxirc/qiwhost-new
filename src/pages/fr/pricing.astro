---

<Layout 
  title={pp.meta.title} 
  description={pp.meta.description}
>
  <!-- Add noindex meta tag -->
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <!-- Hero Section -->
  <Hero
    title={pp.hero.title}
    subtitle={pp.hero.subtitle}
    backgroundClass="bg-gradient-to-r from-primary-700 to-primary-900"
  />

  <!-- Pricing Toggle -->
  <section class="py-12">
    <div class="container">
      <div class="text-center">
        <div class="inline-flex items-center bg-gray-100 p-1 rounded-lg">
          <button id="monthly-toggle" class="px-6 py-2 rounded-md bg-primary-600 text-white font-medium">Monthly</button>
          <button id="yearly-toggle" class="px-6 py-2 rounded-md text-gray-700 font-medium">Yearly (Save 20%)</button>
        </div>
      </div>
    </div>
  </section>

  <!-- VPS Plans -->
  <section id="vps-plans" class="py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{pp.vps.title}</h2>
        <p class="text-xl text-gray-600">Powerful virtual private servers with dedicated resources and full root access.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {vpsPlans.map(plan => (
          <div class={`bg-white rounded-xl shadow-lg overflow-hidden transition-transform duration-300 hover:-translate-y-2 ${plan.popular ? 'border-2 border-primary-500 relative' : ''}`}>
            {plan.popular && (
              <div class="bg-primary-500 text-white text-sm font-semibold py-1 px-4 absolute top-0 right-0 rounded-bl-lg">
                Most Popular
              </div>
            )}
            <div class="p-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{plan.name}</h3>
              <div class="pricing-amount mb-6">
                <div class="monthly-price">
                  <span class="text-4xl font-bold text-gray-900">{plan.price.monthly}</span>
                  <span class="text-gray-600">/month</span>
                </div>
                <div class="yearly-price hidden">
                  <span class="text-4xl font-bold text-gray-900">{plan.price.yearly}</span>
                  <span class="text-gray-600">/month</span>
                  <p class="text-sm text-primary-600 mt-1">Billed annually</p>
                </div>
              </div>
              <p class="text-gray-600 mb-6">{plan.description}</p>
              <ul class="space-y-3 mb-8">
                {plan.features.map(feature => (
                  <li class="flex items-start">
                    <i class="fas fa-check text-primary-500 mr-3 mt-1"></i>
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
              <a href={plan.ctaLink} class={`block text-center py-3 px-4 rounded-lg font-medium transition-colors ${plan.popular ? 'bg-primary-600 text-white hover:bg-primary-700' : 'border-2 border-primary-600 text-primary-600 hover:bg-primary-50'}`}>
                {plan.ctaText}
              </a>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-8">
        <a href="/vps" class="text-primary-600 font-medium hover:text-primary-700 transition-colors">
          Learn more about our VPS hosting <i class="fas fa-arrow-right ml-1"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Dedicated Server Plans -->
  <section id="dedicated-plans" class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{pp.dedicated.title}</h2>
        <p class="text-xl text-gray-600">Powerful physical servers with exclusive resources for maximum performance.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {dedicatedPlans.map(plan => (
          <div class={`bg-white rounded-xl shadow-lg overflow-hidden transition-transform duration-300 hover:-translate-y-2 ${plan.popular ? 'border-2 border-primary-500 relative' : ''}`}>
            {plan.popular && (
              <div class="bg-primary-500 text-white text-sm font-semibold py-1 px-4 absolute top-0 right-0 rounded-bl-lg">
                Most Popular
              </div>
            )}
            <div class="p-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{plan.name}</h3>
              <div class="pricing-amount mb-6">
                <div class="monthly-price">
                  <span class="text-4xl font-bold text-gray-900">{plan.price.monthly}</span>
                  <span class="text-gray-600">/month</span>
                </div>
                <div class="yearly-price hidden">
                  <span class="text-4xl font-bold text-gray-900">{plan.price.yearly}</span>
                  <span class="text-gray-600">/month</span>
                  <p class="text-sm text-primary-600 mt-1">Billed annually</p>
                </div>
              </div>
              <p class="text-gray-600 mb-6">{plan.description}</p>
              <ul class="space-y-3 mb-8">
                {plan.features.map(feature => (
                  <li class="flex items-start">
                    <i class="fas fa-check text-primary-500 mr-3 mt-1"></i>
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
              <a href={plan.ctaLink} class={`block text-center py-3 px-4 rounded-lg font-medium transition-colors ${plan.popular ? 'bg-primary-600 text-white hover:bg-primary-700' : 'border-2 border-primary-600 text-primary-600 hover:bg-primary-50'}`}>
                {plan.ctaText}
              </a>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-8">
        <a href="/dedicated-servers" class="text-primary-600 font-medium hover:text-primary-700 transition-colors">
          Learn more about our dedicated servers <i class="fas fa-arrow-right ml-1"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Private RDP Plans -->
  <section id="rdp-plans" class="py-16">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{pp.rdp.title}</h2>
        <p class="text-xl text-gray-600">Secure remote desktop solutions with full administrator access.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {rdpPlans.map(plan => (
          <div class={`bg-white rounded-xl shadow-lg overflow-hidden transition-transform duration-300 hover:-translate-y-2 ${plan.popular ? 'border-2 border-primary-500 relative' : ''}`}>
            {plan.popular && (
              <div class="bg-primary-500 text-white text-sm font-semibold py-1 px-4 absolute top-0 right-0 rounded-bl-lg">
                Most Popular
              </div>
            )}
            <div class="p-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{plan.name}</h3>
              <div class="pricing-amount mb-6">
                <div class="monthly-price">
                  <span class="text-4xl font-bold text-gray-900">{plan.price.monthly}</span>
                  <span class="text-gray-600">/month</span>
                </div>
                <div class="yearly-price hidden">
                  <span class="text-4xl font-bold text-gray-900">{plan.price.yearly}</span>
                  <span class="text-gray-600">/month</span>
                  <p class="text-sm text-primary-600 mt-1">Billed annually</p>
                </div>
              </div>
              <p class="text-gray-600 mb-6">{plan.description}</p>
              <ul class="space-y-3 mb-8">
                {plan.features.map(feature => (
                  <li class="flex items-start">
                    <i class="fas fa-check text-primary-500 mr-3 mt-1"></i>
                    <span class="text-gray-700">{feature}</span>
                  </li>
                ))}
              </ul>
              <a href={plan.ctaLink} class={`block text-center py-3 px-4 rounded-lg font-medium transition-colors ${plan.popular ? 'bg-primary-600 text-white hover:bg-primary-700' : 'border-2 border-primary-600 text-primary-600 hover:bg-primary-50'}`}>
                {plan.ctaText}
              </a>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-8">
        <a href="/rdp/usa" class="text-primary-600 font-medium hover:text-primary-700 transition-colors">
          Learn more about our Private RDP solutions <i class="fas fa-arrow-right ml-1"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQ faqs={faqs} />

  <!-- CTA Banner -->
  <CTABanner
    title={pp.customCta.title}
    subtitle={pp.customCta.subtitle}
    ctaText={pp.customCta.ctaText}
    ctaLink="/contact"
  />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const monthlyToggle = document.getElementById('monthly-toggle');
    const yearlyToggle = document.getElementById('yearly-toggle');
    const monthlyPrices = document.querySelectorAll('.monthly-price');
    const yearlyPrices = document.querySelectorAll('.yearly-price');
    
    monthlyToggle.addEventListener('click', function() {
      // Update toggle buttons
      monthlyToggle.classList.add('bg-primary-600', 'text-white');
      monthlyToggle.classList.remove('text-gray-700');
      yearlyToggle.classList.remove('bg-primary-600', 'text-white');
      yearlyToggle.classList.add('text-gray-700');
      
      // Show monthly prices, hide yearly prices
      monthlyPrices.forEach(el => el.classList.remove('hidden'));
      yearlyPrices.forEach(el => el.classList.add('hidden'));
    });
    
    yearlyToggle.addEventListener('click', function() {
      // Update toggle buttons
      yearlyToggle.classList.add('bg-primary-600', 'text-white');
      yearlyToggle.classList.remove('text-gray-700');
      monthlyToggle.classList.remove('bg-primary-600', 'text-white');
      monthlyToggle.classList.add('text-gray-700');
      
      // Show yearly prices, hide monthly prices
      yearlyPrices.forEach(el => el.classList.remove('hidden'));
      monthlyPrices.forEach(el => el.classList.add('hidden'));
    });
  });
</script>