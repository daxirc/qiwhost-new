---
import Layout from '../layouts/MainLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { getTranslations, getCurrentLocale } from '../i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = getTranslations(locale);
const dp = t.domainsPage;

// Domain pricing data (demo prices)
const domainPricing = [
  { extension: '.com', registration: '$12.99', renewal: '$14.99', transfer: '$12.99' },
  { extension: '.net', registration: '$14.99', renewal: '$16.99', transfer: '$14.99' },
  { extension: '.org', registration: '$13.99', renewal: '$15.99', transfer: '$13.99' },
  { extension: '.info', registration: '$9.99', renewal: '$19.99', transfer: '$9.99' },
  { extension: '.biz', registration: '$11.99', renewal: '$17.99', transfer: '$11.99' },
  { extension: '.us', registration: '$8.99', renewal: '$12.99', transfer: '$8.99' },
  { extension: '.co', registration: '$24.99', renewal: '$29.99', transfer: '$24.99' },
  { extension: '.io', registration: '$49.99', renewal: '$59.99', transfer: '$49.99' },
  { extension: '.me', registration: '$19.99', renewal: '$24.99', transfer: '$19.99' },
  { extension: '.tv', registration: '$29.99', renewal: '$34.99', transfer: '$29.99' },
  { extension: '.cc', registration: '$22.99', renewal: '$27.99', transfer: '$22.99' },
  { extension: '.mobi', registration: '$16.99', renewal: '$21.99', transfer: '$16.99' },
  { extension: '.name', registration: '$9.99', renewal: '$14.99', transfer: '$9.99' },
  { extension: '.pro', registration: '$18.99', renewal: '$23.99', transfer: '$18.99' },
  { extension: '.asia', registration: '$15.99', renewal: '$20.99', transfer: '$15.99' }
];

// Popular TLDs for the search dropdown
const popularTlds = ['.com', '.net', '.org', '.info', '.biz', '.us', '.co', '.io', '.me', '.tv'];

// Features data
const features = [
  {
    title: "Free DNS Management",
    description: "Complete DNS control with our easy-to-use management interface.",
    icon: "fas fa-cogs"
  },
  {
    title: "Domain Privacy Protection",
    description: "Keep your personal information private with WHOIS protection.",
    icon: "fas fa-shield-alt"
  },
  {
    title: "Easy Domain Transfer",
    description: "Transfer your existing domains to us with our simple process.",
    icon: "fas fa-exchange-alt"
  },
  {
    title: "24/7 Support",
    description: "Expert support available around the clock for all domain issues.",
    icon: "fas fa-headset"
  },
  {
    title: "Auto-Renewal",
    description: "Never lose your domain with automatic renewal options.",
    icon: "fas fa-sync"
  },
  {
    title: "Bulk Management",
    description: "Manage multiple domains efficiently from one dashboard.",
    icon: "fas fa-layer-group"
  }
];
---

<Layout 
  title={dp.meta.title} 
  description={dp.meta.description}
>
  <!-- Red Bar Notice -->
  <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-8 mt-8">
    <div class="container">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <i class="fas fa-exclamation-triangle text-red-500 text-xl mr-3"></i>
        </div>
        <div>
          <p class="font-medium">
            We are currently not offering domain registration, please wait for an update.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Domain Search Section -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Search for Your Domain</h2>
          <p class="text-xl text-gray-600">Enter your desired domain name and check availability instantly</p>
        </div>

        <!-- Domain Search Form -->
        <div class="bg-white rounded-xl shadow-lg p-8 mb-12">
          <form id="domainSearchForm" class="space-y-6">
            <div class="flex flex-col md:flex-row gap-4">
              <div class="flex-1">
                <label for="domainName" class="block text-sm font-medium text-gray-700 mb-2">Domain Name</label>
                <input
                  type="text"
                  id="domainName"
                  name="domain"
                  placeholder="yourdomain"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-lg"
                  required
                />
              </div>
              <div class="md:w-32">
                <label for="tld" class="block text-sm font-medium text-gray-700 mb-2">Extension</label>
                <select
                  id="tld"
                  name="tld"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-lg"
                >
                  {popularTlds.map(tld => (
                    <option value={tld}>{tld}</option>
                  ))}
                </select>
              </div>
              <div class="md:w-auto">
                <label class="block text-sm font-medium text-gray-700 mb-2">&nbsp;</label>
                <button
                  type="submit"
                  class="w-full md:w-auto px-8 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors font-medium text-lg"
                >
                  <i class="fas fa-search mr-2"></i>
                  Search
                </button>
              </div>
            </div>
          </form>

          <!-- Quick Search Suggestions -->
          <div class="mt-6 pt-6 border-t border-gray-200">
            <p class="text-sm text-gray-600 mb-3">Popular extensions:</p>
            <div class="flex flex-wrap gap-2">
              {popularTlds.slice(0, 6).map(tld => (
                <button
                  type="button"
                  class="tld-suggestion px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-primary-100 hover:text-primary-700 transition-colors"
                  data-tld={tld}
                >
                  {tld}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Domain Features -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
          {features.map(feature => (
            <div class="bg-white p-6 rounded-xl shadow-md text-center">
              <div class="bg-primary-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class={`${feature.icon} text-primary-600 text-2xl`}></i>
              </div>
              <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
              <p class="text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Domain Pricing Table -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Domain Pricing</h2>
        <p class="text-xl text-gray-600">Transparent pricing for all popular domain extensions</p>
      </div>

      <div class="bg-white rounded-xl shadow-lg overflow-hidden max-w-6xl mx-auto">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Extension</th>
                <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Registration</th>
                <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Renewal</th>
                <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Transfer</th>
                <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {domainPricing.map((domain, index) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4">
                    <div class="font-medium text-lg text-gray-900">{domain.extension}</div>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <div class="text-lg font-bold text-primary-600">{domain.registration}</div>
                    <div class="text-sm text-gray-500">1st year</div>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <div class="text-lg font-medium text-gray-900">{domain.renewal}</div>
                    <div class="text-sm text-gray-500">per year</div>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <div class="text-lg font-medium text-gray-900">{domain.transfer}</div>
                    <div class="text-sm text-gray-500">+ 1 year</div>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <button
                      class="register-domain-btn inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors font-medium"
                      data-extension={domain.extension}
                    >
                      <i class="fas fa-plus mr-2"></i>
                      Register
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pricing Notes -->
      <div class="mt-8 max-w-4xl mx-auto">
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-info-circle text-blue-500"></i>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-blue-800">Pricing Information</h3>
              <div class="mt-2 text-sm text-blue-700">
                <ul class="list-disc list-inside space-y-1">
                  <li>All prices are in USD and include ICANN fees where applicable</li>
                  <li>Domain privacy protection available for additional $9.99/year</li>
                  <li>Bulk discounts available for 10+ domains</li>
                  <li>Free DNS management included with all domains</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title={dp.cta.title}
    subtitle={dp.cta.subtitle}
    ctaText={dp.cta.ctaText}
    ctaLink="#"
  />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const domainSearchForm = document.getElementById('domainSearchForm');
    const domainNameInput = document.getElementById('domainName');
    const tldSelect = document.getElementById('tld');
    const tldSuggestions = document.querySelectorAll('.tld-suggestion');
    const registerButtons = document.querySelectorAll('.register-domain-btn');

    // Handle domain search form submission
    domainSearchForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const domainName = domainNameInput.value.trim();
      const tld = tldSelect.value;
      
      if (domainName) {
        // Redirect to WHMCS with domain search
        const searchUrl = `https://portal.qiwhost.com/cart.php?a=add&domain=register&query=${encodeURIComponent(domainName + tld)}`;
        window.open(searchUrl, '_blank');
      }
    });

    // Handle TLD suggestion clicks
    tldSuggestions.forEach(button => {
      button.addEventListener('click', function() {
        const tld = this.getAttribute('data-tld');
        tldSelect.value = tld;
      });
    });

    // Handle register domain button clicks
    registerButtons.forEach(button => {
      button.addEventListener('click', function() {
        const extension = this.getAttribute('data-extension');
        const domainName = domainNameInput.value.trim() || 'yourdomain';
        
        // Redirect to WHMCS with specific domain
        const registerUrl = `https://portal.qiwhost.com/cart.php?a=add&domain=register&query=${encodeURIComponent(domainName + extension)}`;
        window.open(registerUrl, '_blank');
      });
    });

    // Auto-focus on domain name input
    domainNameInput.focus();
  });
</script>