// Features
const forexFeatures = [
  {
    title: "Red de Baja Latencia",
    description: "Ejecute operaciones en milisegundos. Nuestros servidores están ubicados estratégicamente cerca de los principales centros de datos de brókers para la menor latencia posible.",
    icon: "fas fa-network-wired"
  },
  {
    title: "Listo para Windows Server",
    description: "Entornos de Windows Server con licencia completa preinstalados, ofreciendo una interfaz de escritorio familiar accesible a través de Escritorio Remoto (RDP).",
    icon: "fab fa-windows"
  },
  {
    title: "Compatible con MT4 y MT5",
    description: "Perfectamente optimizado para ejecutar MetaTrader 4, MetaTrader 5, cTrader y otras plataformas líderes de trading de forex sin restricciones.",
    icon: "fas fa-chart-line"
  },
  {
    title: "Tiempo de Actividad 24/7 Ininterrumpido",
    description: "No permita que los cortes de internet o de energía locales detengan sus operaciones. Nuestros centros de datos ofrecen garantías de tiempo de actividad del 99.99%.",
