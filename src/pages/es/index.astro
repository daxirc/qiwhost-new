---
import Layout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import PricingTable from '../../components/PricingTable.astro';
import DatacenterMap from '../../components/DatacenterMap.astro';
import ServerManagement from '../../components/ServerManagement.astro';
import FAQ from '../../components/FAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getTranslations, getCurrentLocale } from '../../i18n/utils';

// Get translations for current locale
const locale = getCurrentLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Features data with translations
const features = [
  {
    title: t.services.vps.title,
    description: t.services.vps.description,
    icon: "fas fa-server"
  },
  {
    title: t.services.dedicated.title,
    description: t.services.dedicated.description,
    icon: "fas fa-hdd"
  },
  {
    title: t.services.rdp.title,
    description: t.services.rdp.description,
    icon: "fas fa-desktop"
  },
  {
    title: t.services.uptime.title,
    description: t.services.uptime.description,
    icon: "fas fa-chart-line"
  },
  {
    title: t.services.techSupport.title,
    description: t.services.techSupport.description,
    icon: "fas fa-headset"
  },
  {
    title: t.services.globalNetwork.title,
    description: t.services.globalNetwork.description,
    icon: "fas fa-globe"
  }
];

// Pricing plans data with translations
const plans = [
  {
    name: t.pricing.starterVps.name,
    price: {
      monthly: "$9.99",
      yearly: "$7.99"
    },
    description: t.pricing.starterVps.description,
    features: t.pricing.starterVps.features,
    ctaText: t.pricing.ctaText,
    ctaLink: "https://portal.qiwhost.com/login"
  },
  {
    name: t.pricing.businessVps.name,
    price: {
      monthly: "$19.99",
      yearly: "$15.99"
    },
    description: t.pricing.businessVps.description,
    features: t.pricing.businessVps.features,
    ctaText: t.pricing.ctaText,
    ctaLink: "https://portal.qiwhost.com/login",
    popular: true
  },
  {
    name: t.pricing.enterpriseVps.name,
    price: {
      monthly: "$39.99",
      yearly: "$31.99"
    },
    description: t.pricing.enterpriseVps.description,
    features: t.pricing.enterpriseVps.features,
    ctaText: t.pricing.ctaText,
    ctaLink: "https://portal.qiwhost.com/login"
  }
];

// FAQ data with translations
const faqs = t.faq.questions;
---

<Layout 
  title={t.meta.title}
  description={t.meta.description}
>
  <!-- Hero Section -->
  <Hero
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    ctaText={t.hero.ctaText}
    ctaLink="https://portal.qiwhost.com/login"
    secondaryCtaText={t.hero.secondaryCtaText}
    secondaryCtaLink="#features"
  />

  <!-- Trust Indicators -->
  <section class="py-8 bg-white border-b">
    <div class="container">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16">
        <div class="flex items-center">
          <i class="fas fa-server text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.trustIndicators.uptime}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-shield-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.trustIndicators.security}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-headset text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.trustIndicators.support}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-globe text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.trustIndicators.network}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <div id="features">
    <FeaturesSection
      title={t.services.title}
      subtitle={t.services.subtitle}
      features={features}
    />
  </div>

  <!-- Why Choose Us Section -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{t.whyChooseUs.title}</h2>
          <p class="text-lg text-gray-700 mb-8">{t.whyChooseUs.description}</p>
          
          <div class="space-y-4">
            <div class="flex items-start">
              <div class="bg-primary-100 rounded-full p-2 mt-1 mr-4">
                <i class="fas fa-check text-primary-600"></i>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2">{t.whyChooseUs.enterpriseInfra.title}</h3>
                <p class="text-gray-600">{t.whyChooseUs.enterpriseInfra.description}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-primary-100 rounded-full p-2 mt-1 mr-4">
                <i class="fas fa-check text-primary-600"></i>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2">{t.whyChooseUs.expertSupport.title}</h3>
                <p class="text-gray-600">{t.whyChooseUs.expertSupport.description}</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="bg-primary-100 rounded-full p-2 mt-1 mr-4">
                <i class="fas fa-check text-primary-600"></i>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2">{t.whyChooseUs.transparentPricing.title}</h3>
                <p class="text-gray-600">{t.whyChooseUs.transparentPricing.description}</p>
              </div>
            </div>
          </div>
          
          <a href="/about" class="btn btn-primary mt-8">{t.whyChooseUs.learnMoreCta}</a>
        </div>
        
        <div class="relative">
          <div class="bg-primary-100 rounded-lg p-8 relative z-10">
            <img src="https://images.pexels.com/photos/325229/pexels-photo-325229.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" alt="Data Center" class="rounded-lg shadow-lg" />
          </div>
          <div class="absolute top-8 left-8 right-8 bottom-8 border-2 border-primary-500 rounded-lg -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Preview -->
  <PricingTable
    title={t.pricing.title}
    description={t.pricing.description}
    plans={plans}
  />

  <!-- Datacenter Map -->
  <DatacenterMap />

  <!-- Server Management Features -->
  <ServerManagement />

  <!-- FAQ Section -->
  <FAQ faqs={faqs} title={t.faq.title} subtitle={t.faq.subtitle} />

  <!-- CTA Banner -->
  <CTABanner
    title={t.ctaBanner.title}
    subtitle={t.ctaBanner.subtitle}
    ctaText={t.ctaBanner.ctaText}
    ctaLink="https://portal.qiwhost.com/login"
  />
</Layout>