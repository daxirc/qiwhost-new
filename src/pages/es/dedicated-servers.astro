---
import Layout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import PricingTable from '../../components/PricingTable.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getDedicatedPlans } from '../../lib/db';
import { getTranslations, getCurrentLocale } from '../../i18n/utils';

// Get translations for current locale
const locale = getCurrentLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Fetch plans from database
const plans = await getDedicatedPlans();

// Convert plans to pricing table format
function formatPlans(plans) {
  return plans.map(plan => ({
    name: plan.name,
    price: {
      monthly: `$${plan.price_monthly}`
    },
    description: `${plan.cpu}, ${plan.ram} RAM, ${plan.storage}`,
    features: [
      plan.cpu,
      plan.ram,
      plan.storage,
      plan.bandwidth,
      plan.location,
      'Full Root Access',
      '24/7 Support'
    ],
    ctaText: t.pricing.ctaText,
    ctaLink: plan.order_url,
    sale_enabled: plan.sale_enabled,
    sale_price_monthly: plan.sale_price_monthly ? `$${plan.sale_price_monthly}` : undefined,
    sale_badge_text: plan.sale_badge_text,
    osType: plan.os_type
  }));
}

// Group plans by subcategory
const valueServers = formatPlans(plans?.filter(plan => plan.subcategory === 'VALUE') || []);
const customServers = formatPlans(plans?.filter(plan => plan.subcategory === 'CUSTOM') || []);
const gpuServers = formatPlans(plans?.filter(plan => plan.subcategory === 'GPU') || []);

// Features data with translations
const features = [
  {
    title: t.dedicatedServers.features.enterpriseHardware.title,
    description: t.dedicatedServers.features.enterpriseHardware.description,
    icon: "fas fa-microchip"
  },
  {
    title: t.dedicatedServers.features.rootAccess.title,
    description: t.dedicatedServers.features.rootAccess.description,
    icon: "fas fa-key"
  },
  {
    title: t.dedicatedServers.features.raid.title,
    description: t.dedicatedServers.features.raid.description,
    icon: "fas fa-hdd"
  },
  {
    title: t.dedicatedServers.features.ddosProtection.title,
    description: t.dedicatedServers.features.ddosProtection.description,
    icon: "fas fa-shield-alt"
  },
  {
    title: t.dedicatedServers.features.support.title,
    description: t.dedicatedServers.features.support.description,
    icon: "fas fa-headset"
  },
  {
    title: t.dedicatedServers.features.network.title,
    description: t.dedicatedServers.features.network.description,
    icon: "fas fa-globe"
  }
];
---

<Layout 
  title="Dedicated Servers" 
  description="High-performance dedicated servers with enterprise-grade hardware, full root access, and 24/7 support."
>
  <!-- Hero Section -->
  <Hero
    title={t.dedicatedServers.hero.title}
    subtitle={t.dedicatedServers.hero.subtitle}
    ctaText="View Servers"
    ctaLink="#pricing"
    showFeatureBadges={true}
  />

  <!-- Server Plans -->
  <section id="pricing" class="py-16 md:py-24">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{t.dedicatedServers.pricing.title}</h2>
        <p class="text-xl text-gray-600">{t.dedicatedServers.pricing.subtitle}</p>
      </div>

      <!-- Server Type Tabs -->
      <div class="mb-12">
        <div class="flex flex-wrap justify-center">
          <div class="bg-white rounded-xl shadow-lg p-1.5 inline-flex">
            <button 
              id="value-tab" 
              class="tab-button active px-8 py-3 rounded-lg font-medium text-lg transition-all duration-200"
            >
              <span>{t.dedicatedServers.pricing.valueServers}</span>
            </button>
            <button 
              id="custom-tab" 
              class="tab-button px-8 py-3 rounded-lg font-medium text-lg transition-all duration-200"
            >
              <span>{t.dedicatedServers.pricing.customServers}</span>
            </button>
            <button 
              id="gpu-tab" 
              class="tab-button px-8 py-3 rounded-lg font-medium text-lg transition-all duration-200"
            >
              <span>{t.dedicatedServers.pricing.gpuServers}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="max-w-7xl mx-auto">
        <!-- Value Servers -->
        <div id="value-servers">
          <PricingTable
            title={t.dedicatedServers.pricing.valueServers}
            description={t.dedicatedServers.pricing.valueDescription}
            plans={valueServers}
            category="DEDICATED"
          />
        </div>

        <!-- Custom Servers -->
        <div id="custom-servers" class="hidden">
          <PricingTable
            title={t.dedicatedServers.pricing.customServers}
            description={t.dedicatedServers.pricing.customDescription}
            plans={customServers}
            category="DEDICATED"
          />
        </div>

        <!-- GPU Servers -->
        <div id="gpu-servers" class="hidden">
          <PricingTable
            title={t.dedicatedServers.pricing.gpuServers}
            description={t.dedicatedServers.pricing.gpuDescription}
            plans={gpuServers}
            category="DEDICATED"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <FeaturesSection
    title={t.dedicatedServers.features.title}
    subtitle={t.dedicatedServers.features.subtitle}
    features={features}
  />

  <!-- CTA Banner -->
  <CTABanner
    title={t.dedicatedServers.cta.title}
    subtitle={t.dedicatedServers.cta.subtitle}
    ctaText="Order Now"
    ctaLink="https://portal.qiwhost.com/login"
  />
</Layout>

<style>
  .tab-button {
    @apply text-gray-700 hover:text-primary-600 relative overflow-hidden;
  }

  .tab-button::after {
    content: '';
    @apply absolute inset-0 bg-gradient-to-r from-primary-600 to-primary-700 opacity-0 transition-opacity duration-200;
    z-index: 0;
  }

  .tab-button.active {
    @apply text-white;
  }

  .tab-button.active::after {
    @apply opacity-100;
  }

  .tab-button span {
    @apply relative z-10;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const valueTab = document.getElementById('value-tab');
    const customTab = document.getElementById('custom-tab');
    const gpuTab = document.getElementById('gpu-tab');
    
    const valueServers = document.getElementById('value-servers');
    const customServers = document.getElementById('custom-servers');
    const gpuServers = document.getElementById('gpu-servers');
    
    function showTab(tab) {
      // Hide all tables
      valueServers.classList.add('hidden');
      customServers.classList.add('hidden');
      gpuServers.classList.add('hidden');
      
      // Reset all tab styles
      [valueTab, customTab, gpuTab].forEach(button => {
        button.classList.remove('active');
      });
      
      // Show selected table and style active tab
      if (tab === 'value') {
        valueServers.classList.remove('hidden');
        valueTab.classList.add('active');
      } else if (tab === 'custom') {
        customServers.classList.remove('hidden');
        customTab.classList.add('active');
      } else if (tab === 'gpu') {
        gpuServers.classList.remove('hidden');
        gpuTab.classList.add('active');
      }
    }
    
    valueTab.addEventListener('click', () => showTab('value'));
    customTab.addEventListener('click', () => showTab('custom'));
    gpuTab.addEventListener('click', () => showTab('gpu'));
  });
</script>