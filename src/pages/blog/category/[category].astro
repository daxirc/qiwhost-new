---
import Layout from '../../../layouts/MainLayout.astro';
import Hero from '../../../components/Hero.astro';
import BlogCard from '../../../components/BlogCard.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import CTABanner from '../../../components/CTABanner.astro';
import { getBlogPosts } from '../../../lib/db';

export function getStaticPaths() {
  // Define categories within getStaticPaths to ensure they're in scope
  const categories = [
    { slug: 'vps-hosting', name: 'VPS Hosting' },
    { slug: 'dedicated-servers', name: 'Dedicated Servers' },
    { slug: 'rdp-solutions', name: 'RDP Solutions' },
    { slug: 'tutorials', name: 'Tutorials' },
    { slug: 'news', name: 'News' }
  ];

  return categories.map(category => ({
    params: { category: category.slug },
    props: { categoryName: category.name }
  }));
}

const { category } = Astro.params;
const { categoryName } = Astro.props;

// For now, just fetch all published posts
// In the future, this would filter by category
const posts = await getBlogPosts({ status: 'published', orderBy: 'published_at' });

// Simulate category filtering (this would be replaced with actual filtering when categories are implemented)
const filteredPosts = posts || [];
---

<Layout 
  title={`${categoryName} - QIW HOST Blog`}
  description={`Read our latest articles about ${categoryName.toLowerCase()} - tips, tutorials, and insights from QIW HOST.`}
>
  <!-- Hero Section -->
  <Hero
    title={categoryName}
    subtitle={`Articles, tutorials, and insights about ${categoryName.toLowerCase()}`}
    backgroundClass="bg-gradient-to-r from-primary-700 to-primary-900"
  />

  <!-- Blog Content Section -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          {filteredPosts.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {filteredPosts.map((post) => (
                <BlogCard
                  title={post.title}
                  slug={post.slug}
                  description={post.description}
                  featuredImage={post.featured_image}
                  publishedAt={post.published_at}
                />
              ))}
            </div>
          ) : (
            <div class="text-center py-16 bg-gray-50 rounded-xl">
              <div class="text-gray-400 text-6xl mb-4">
                <i class="fas fa-newspaper"></i>
              </div>
              <h2 class="text-2xl font-bold text-gray-900 mb-2">No Posts in This Category Yet</h2>
              <p class="text-gray-600 max-w-lg mx-auto">
                We're working on creating valuable content for this category. Check back soon for articles, tutorials, and news.
              </p>
              <a href="/blog" class="inline-block mt-6 text-primary-600 hover:text-primary-700 font-medium">
                <i class="fas fa-arrow-left mr-2"></i>
                Back to All Posts
              </a>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <BlogSidebar />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title="Ready to Get Started with QIW HOST?"
    subtitle="Experience our high-performance hosting solutions today."
    ctaText="View Pricing"
    ctaLink="/pricing"
  />
</Layout>