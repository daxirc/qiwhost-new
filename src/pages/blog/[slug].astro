---
import Layout from '../../layouts/MainLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { fetchBlogPosts } from '../../lib/api';
import { format } from 'date-fns';

export async function getStaticPaths() {
  const posts = await fetchBlogPosts();
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const contentHtml = post.content;

const formattedDate = post.published_at
  ? format(new Date(post.published_at), 'MMMM d, yyyy')
  : null;

const isoDate = post.published_at
  ? new Date(post.published_at).toISOString()
  : '';

const seoTitle = post.seo_title || post.title;
const seoDescription = post.seo_description || post.description;
const siteUrl = 'https://qiwhost.com';
const canonicalUrl = `${siteUrl}/blog/${post.slug}/`;
const featuredImage = post.featured_image?.startsWith('http')
  ? post.featured_image
  : `${siteUrl}${post.featured_image}`;

// Estimate reading time (~200 wpm)
const wordCount = (post.content || '').replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Structured data (Article schema)
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": seoDescription,
  "image": featuredImage,
  "datePublished": isoDate,
  "dateModified": post.updated_at ? new Date(post.updated_at).toISOString() : isoDate,
  "author": { "@type": "Organization", "name": "QIW Host", "url": siteUrl },
  "publisher": {
    "@type": "Organization",
    "name": "QIW Host",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/images/logo.png` }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  "wordCount": wordCount
});

// FAQ schema — extract from content if FAQ section exists
const faqMatches = [...(post.content || '').matchAll(/<h3>(.*?)<\/h3>\s*<p>([\s\S]*?)<\/p>/g)];
const faqItems = faqMatches
  .filter(m => m[1] && !m[1].includes('Step'))
  .slice(-6)
  .map(m => ({
    "@type": "Question",
    "name": m[1].replace(/<[^>]*>/g, ''),
    "acceptedAnswer": { "@type": "Answer", "text": m[2].replace(/<[^>]*>/g, '').trim() }
  }));

const faqJsonLd = faqItems.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems
}) : null;
---

<Layout
  title={`${seoTitle} | QIW HOST Blog`}
  description={seoDescription}
>
  <!-- SEO Meta -->
  <link rel="canonical" href={canonicalUrl} slot="head" />
  <meta property="og:title" content={seoTitle} slot="head" />
  <meta property="og:description" content={seoDescription} slot="head" />
  <meta property="og:image" content={featuredImage} slot="head" />
  <meta property="og:url" content={canonicalUrl} slot="head" />
  <meta property="og:type" content="article" slot="head" />
  <meta property="og:site_name" content="QIW Host" slot="head" />
  <meta property="article:published_time" content={isoDate} slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={seoTitle} slot="head" />
  <meta name="twitter:description" content={seoDescription} slot="head" />
  <meta name="twitter:image" content={featuredImage} slot="head" />

  <!-- Article Schema -->
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} slot="head" />}

  <article class="blog-post">
    <!-- Header -->
    <header class="post-header">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <a href="/blog/" class="back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7l-7 7 7 7"/></svg>
            Back to Blog
          </a>

          <h1 class="post-title">{post.title}</h1>

          {post.description && (
            <p class="post-excerpt">{post.description}</p>
          )}

          <div class="post-meta">
            {formattedDate && (
              <span class="meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <time datetime={isoDate}>{formattedDate}</time>
              </span>
            )}
            <span class="meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {readingTime} min read
            </span>
            <span class="meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              QIW Host Team
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    {post.featured_image && (
      <div class="featured-image-wrap">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto">
            <img
              src={post.featured_image}
              alt={post.title}
              class="featured-image"
              loading="eager"
              width="768"
              height="403"
            />
          </div>
        </div>
      </div>
    )}

    <!-- Content -->
    <div class="post-content-wrap">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <div class="prose">
            <Fragment set:html={contentHtml} />
          </div>
        </div>
      </div>
    </div>

    <!-- Share & Tags -->
    <footer class="post-footer">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <div class="share-bar">
            <span class="share-label">Share this article</span>
            <div class="share-buttons">
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn twitter" aria-label="Share on Twitter">
                <i class="fab fa-x-twitter"></i>
              </a>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn facebook" aria-label="Share on Facebook">
                <i class="fab fa-facebook-f"></i>
              </a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn linkedin" aria-label="Share on LinkedIn">
                <i class="fab fa-linkedin-in"></i>
              </a>
              <button class="share-btn copy-link" data-url={canonicalUrl} aria-label="Copy link">
                <i class="fas fa-link"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </article>

  <!-- CTA -->
  <CTABanner
    title="Need Expert Server Support?"
    subtitle="QIW Host provides reliable VPS, shared hosting, and dedicated servers with 24/7 technical support."
    ctaText="Explore Hosting Plans"
    ctaLink="/vps/"
  />
</Layout>

<style is:global>
  /* ── Header ── */
  .post-header {
    padding: 3rem 0 2rem;
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    text-decoration: none;
    margin-bottom: 1.25rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: #3b82f6; }

  .post-title {
    font-size: 2rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.25;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    .post-title { font-size: 2.5rem; }
  }

  .post-excerpt {
    font-size: 1.1rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    font-weight: 500;
    color: #9ca3af;
  }
  .meta-item svg { opacity: 0.7; }

  /* ── Featured Image ── */
  .featured-image-wrap {
    padding: 2rem 0 0;
  }
  .featured-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
    max-height: 400px;
    border: 1px solid #e5e7eb;
  }

  /* ── Content ── */
  .post-content-wrap {
    padding: 2.5rem 0 3rem;
  }

  .prose {
    color: #374151;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e5e7eb;
  }
  .prose h3 {
    font-size: 1.2rem;
    font-weight: 600;
    color: #1f2937;
    margin: 2rem 0 0.5rem;
  }
  .prose p {
    margin: 1rem 0;
  }
  .prose a {
    color: #2563eb;
    text-decoration: underline;
    text-decoration-color: #93c5fd;
    text-underline-offset: 2px;
    font-weight: 500;
    transition: color 0.2s;
  }
  .prose a:hover { color: #1d4ed8; text-decoration-color: #2563eb; }

  .prose ul, .prose ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  .prose ul { list-style: disc; }
  .prose ol { list-style: decimal; }
  .prose li {
    margin: 0.4rem 0;
    line-height: 1.7;
  }

  .prose code {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    background: #f1f5f9;
    color: #0f172a;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
  }
  .prose pre {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 1.5rem 0;
    border: 1px solid #1e293b;
  }
  .prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .prose blockquote {
    border-left: 3px solid #3b82f6;
    background: #f8fafc;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 8px 8px 0;
    color: #475569;
    font-style: italic;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
  .prose hr {
    border: none;
    border-top: 2px solid #e5e7eb;
    margin: 2.5rem 0;
  }
  .prose strong { color: #111827; }

  /* ── Footer / Share ── */
  .post-footer {
    padding: 0 0 3rem;
  }
  .share-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid #e5e7eb;
  }
  .share-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #6b7280;
    white-space: nowrap;
  }
  .share-buttons {
    display: flex;
    gap: 0.5rem;
  }
  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: #6b7280;
    background: #f3f4f6;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    font-size: 0.85rem;
  }
  .share-btn:hover { transform: translateY(-1px); }
  .share-btn.twitter:hover { background: #0f1419; color: white; }
  .share-btn.facebook:hover { background: #1877f2; color: white; }
  .share-btn.linkedin:hover { background: #0a66c2; color: white; }
  .share-btn.copy-link:hover { background: #3b82f6; color: white; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-link').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        navigator.clipboard.writeText(url).then(() => {
          const icon = btn.querySelector('i');
          icon.className = 'fas fa-check';
          setTimeout(() => { icon.className = 'fas fa-link'; }, 2000);
        });
      });
    });
  });
</script>