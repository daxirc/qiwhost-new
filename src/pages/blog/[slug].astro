---
import Layout from '../../layouts/MainLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { supabase } from '../../lib/supabase';
import { marked } from 'marked';
import { format } from 'date-fns';

export async function getStaticPaths() {
  // Fetch all published blog posts
  const { data: posts, error } = await supabase
    .from('blog_posts')
    .select('*')
    .eq('status', 'published');

  if (error) {
    console.error('Error fetching blog posts:', error);
    return [];
  }

  // Create a path for each post
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Parse markdown content to HTML
const contentHtml = marked.parse(post.content);

// Format the published date
const formattedDate = post.published_at 
  ? format(new Date(post.published_at), 'MMMM d, yyyy')
  : null;

// SEO values
const seoTitle = post.seo_title || post.title;
const seoDescription = post.seo_description || post.description;
const canonicalUrl = new URL(`/blog/${post.slug}`, Astro.site).href;
---

<Layout 
  title={`${seoTitle} | QIW HOST Blog`}
  description={seoDescription}
>
  <!-- Add Open Graph tags for social sharing -->
  <meta property="og:title" content={seoTitle} slot="head" />
  <meta property="og:description" content={seoDescription} slot="head" />
  <meta property="og:image" content={post.featured_image} slot="head" />
  <meta property="og:url" content={canonicalUrl} slot="head" />
  <meta property="og:type" content="article" slot="head" />
  <link rel="canonical" href={canonicalUrl} slot="head" />

  <!-- Blog Post Header -->
  <header class="py-16 md:py-24 bg-gradient-to-r from-primary-700 to-primary-900 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="mb-6">
          <a href="/blog" class="inline-flex items-center text-white/80 hover:text-white transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Blog
          </a>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">{post.title}</h1>
        {formattedDate && (
          <div class="flex items-center text-white/80">
            <i class="far fa-calendar-alt mr-2"></i>
            <time datetime={post.published_at}>{formattedDate}</time>
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- Featured Image -->
  <div class="relative -mt-12 mb-12">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="aspect-w-16 aspect-h-9 rounded-xl overflow-hidden shadow-xl">
          <img 
            src={post.featured_image} 
            alt={post.title} 
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Blog Post Content -->
  <article class="py-8 md:py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="prose prose-lg max-w-none">
          <Fragment set:html={contentHtml} />
        </div>
      </div>
    </div>
  </article>

  <!-- Share Links -->
  <section class="pb-16">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="border-t border-gray-200 pt-8">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Share this article</h3>
          <div class="flex space-x-4">
            <a 
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(canonicalUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-[#1DA1F2] text-white p-2 rounded-full hover:bg-opacity-90 transition-colors"
              aria-label="Share on Twitter"
            >
              <i class="fab fa-twitter"></i>
            </a>
            <a 
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-[#4267B2] text-white p-2 rounded-full hover:bg-opacity-90 transition-colors"
              aria-label="Share on Facebook"
            >
              <i class="fab fa-facebook-f"></i>
            </a>
            <a 
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-[#0077B5] text-white p-2 rounded-full hover:bg-opacity-90 transition-colors"
              aria-label="Share on LinkedIn"
            >
              <i class="fab fa-linkedin-in"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title="Ready to Get Started with QIW HOST?"
    subtitle="Experience our high-performance hosting solutions today."
    ctaText="View Pricing"
    ctaLink="/pricing"
  />
</Layout>

<style is:global>
  /* Add some basic styling for the blog content */
  .prose {
    color: #374151;
    max-width: 65ch;
    margin: 0 auto;
  }
  
  .prose h1 {
    font-size: 2.25rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: #1f2937;
  }
  
  .prose h2 {
    font-size: 1.875rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    color: #1f2937;
  }
  
  .prose h3 {
    font-size: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    color: #1f2937;
  }
  
  .prose p {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }
  
  .prose a {
    color: #3365f3;
    text-decoration: underline;
    font-weight: 500;
  }
  
  .prose a:hover {
    color: #2857e3;
  }
  
  .prose ul {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.625rem;
    list-style-type: disc;
  }
  
  .prose ol {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.625rem;
    list-style-type: decimal;
  }
  
  .prose li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  
  .prose blockquote {
    font-style: italic;
    color: #6b7280;
    border-left-width: 4px;
    border-left-color: #e5e7eb;
    padding-left: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .prose img {
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-radius: 0.375rem;
    max-width: 100%;
    height: auto;
  }
  
  .prose code {
    color: #111827;
    background-color: #f3f4f6;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.875em;
  }
  
  .prose pre {
    color: #e5e7eb;
    background-color: #1f2937;
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.7142857;
    margin-top: 1.7142857em;
    margin-bottom: 1.7142857em;
    border-radius: 0.375rem;
    padding: 0.8571429em 1.1428571em;
  }
  
  .prose pre code {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    font-weight: 400;
    color: inherit;
    font-size: inherit;
    font-family: inherit;
    line-height: inherit;
  }
  
  .prose hr {
    border-color: #e5e7eb;
    margin-top: 3em;
    margin-bottom: 3em;
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .prose h1 {
      font-size: 1.875rem;
    }
    
    .prose h2 {
      font-size: 1.5rem;
    }
    
    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>