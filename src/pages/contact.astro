---
import Layout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';

// Contact information
const contactInfo = {
  email: "support@qiwhost.com",
  phone: "+1 (234) 567-890",
  address: "123 Hosting Street, Server City, 10010",
  hours: "Monday - Friday: 9:00 AM - 6:00 PM"
};
---

<Layout 
  title="Contact Us" 
  description="Get in touch with the QIW HOST team for sales inquiries, technical support, or general questions."
>
  <!-- Hero Section -->
  <Hero
    title="Contact Us"
    subtitle="Have questions? We're here to help. Reach out to our team for assistance."
    backgroundClass="bg-gradient-to-r from-primary-700 to-primary-900"
  />

  <!-- Contact Section -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-xl shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Contact Information</h2>
            
            <div class="space-y-6">
              <div class="flex items-start">
                <div class="bg-primary-100 rounded-full p-3 mr-4">
                  <i class="fas fa-envelope text-primary-600"></i>
                </div>
                <div>
                  <h3 class="text-lg font-semibold mb-1">Email</h3>
                  <a href={`mailto:${contactInfo.email}`} class="text-gray-600 hover:text-primary-600 transition-colors">
                    {contactInfo.email}
                  </a>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="bg-primary-100 rounded-full p-3 mr-4">
                  <i class="fas fa-phone-alt text-primary-600"></i>
                </div>
                <div>
                  <h3 class="text-lg font-semibold mb-1">Phone</h3>
                  <a href={`tel:${contactInfo.phone.replace(/\D/g, '')}`} class="text-gray-600 hover:text-primary-600 transition-colors">
                    {contactInfo.phone}
                  </a>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="bg-primary-100 rounded-full p-3 mr-4">
                  <i class="fas fa-map-marker-alt text-primary-600"></i>
                </div>
                <div>
                  <h3 class="text-lg font-semibold mb-1">Address</h3>
                  <p class="text-gray-600">
                    {contactInfo.address}
                  </p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="bg-primary-100 rounded-full p-3 mr-4">
                  <i class="fas fa-clock text-primary-600"></i>
                </div>
                <div>
                  <h3 class="text-lg font-semibold mb-1">Business Hours</h3>
                  <p class="text-gray-600">
                    {contactInfo.hours}
                  </p>
                </div>
              </div>
            </div>
            
            <!-- Social Media Links -->
            <div class="mt-8">
              <h3 class="text-lg font-semibold mb-4">Connect With Us</h3>
              <div class="flex space-x-4">
                <a href="#" class="bg-primary-100 text-primary-600 hover:bg-primary-200 p-3 rounded-full transition-colors">
                  <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" class="bg-primary-100 text-primary-600 hover:bg-primary-200 p-3 rounded-full transition-colors">
                  <i class="fab fa-twitter"></i>
                </a>
                <a href="#" class="bg-primary-100 text-primary-600 hover:bg-primary-200 p-3 rounded-full transition-colors">
                  <i class="fab fa-linkedin-in"></i>
                </a>
                <a href="#" class="bg-primary-100 text-primary-600 hover:bg-primary-200 p-3 rounded-full transition-colors">
                  <i class="fab fa-instagram"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Send Us a Message</h2>
            
            <form id="contactForm" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="firstName" class="block text-gray-700 font-medium mb-2">First Name</label>
                  <input 
                    type="text" 
                    id="firstName" 
                    name="firstName" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                    required
                  />
                </div>
                
                <div>
                  <label for="lastName" class="block text-gray-700 font-medium mb-2">Last Name</label>
                  <input 
                    type="text" 
                    id="lastName" 
                    name="lastName" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                    required
                  />
                </div>
              </div>
              
              <div>
                <label for="email" class="block text-gray-700 font-medium mb-2">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                  required
                />
              </div>
              
              <div>
                <label for="subject" class="block text-gray-700 font-medium mb-2">Subject</label>
                <input 
                  type="text" 
                  id="subject" 
                  name="subject" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                  required
                />
              </div>
              
              <div>
                <label for="message" class="block text-gray-700 font-medium mb-2">Message</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="5" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                  required
                ></textarea>
              </div>
              
              <div>
                <button 
                  type="submit" 
                  class="w-full bg-primary-600 text-white font-medium py-3 px-6 rounded-lg hover:bg-primary-700 transition-colors"
                >
                  Send Message
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <div class="bg-white rounded-xl shadow-md p-4">
          <div class="aspect-w-16 aspect-h-9">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d387193.30594994064!2d-74.25986652425035!3d40.697149422113014!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew%20York%2C%20NY%2C%20USA!5e0!3m2!1sen!2s!4v1679568203420!5m2!1sen!2s" 
              width="100%" 
              height="450" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              class="rounded-lg"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const contactForm = document.getElementById('contactForm');
    
    contactForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Here you would typically send the form data to your backend
      // For demo purposes, we'll just show a success message
      
      const formData = new FormData(contactForm);
      const formValues = Object.fromEntries(formData.entries());
      
      // Replace form with success message
      contactForm.innerHTML = `
        <div class="text-center py-8">
          <div class="bg-green-100 text-green-700 p-4 rounded-lg mb-6">
            <i class="fas fa-check-circle text-4xl mb-4"></i>
            <h3 class="text-xl font-bold mb-2">Message Sent Successfully!</h3>
            <p>Thank you for contacting us, ${formValues.firstName}. We'll get back to you shortly.</p>
          </div>
          <button onclick="location.reload()" class="bg-primary-600 text-white font-medium py-3 px-6 rounded-lg hover:bg-primary-700 transition-colors">
            Send Another Message
          </button>
        </div>
      `;
    });
  });
</script>