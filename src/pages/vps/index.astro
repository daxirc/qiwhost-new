---
import Layout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import PricingTable from '../../components/PricingTable.astro';
import CTABanner from '../../components/CTABanner.astro';
import LocationCard from '../../components/LocationCard.astro';
import { vpsLocations, getFeaturedVpsPlans, getBackgroundImage } from '../../data/plans';
import { getTranslations, getCurrentLocale } from '../../i18n/utils';

// Get translations for current locale
const locale = getCurrentLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Get featured VPS plans (hardcoded)
const featuredPlans = getFeaturedVpsPlans();

// Convert to pricing table format
const plans = featuredPlans.map(plan => ({
  name: plan.name,
  price: {
    monthly: `$${plan.priceMonthly}`,
    yearly: `$${(plan.priceAnnually / 12).toFixed(2)}`
  },
  description: `${plan.cpu}, ${plan.ram}, ${plan.storage}`,
  features: [
    plan.cpu,
    plan.ram,
    plan.storage,
    plan.bandwidth,
    '24/7 Support',
    'Full Root Access'
  ],
  ctaText: t.pricing.ctaText,
  ctaLink: plan.cartUrl,
  popular: plan.tier === 'Professional',
  osType: 'Linux'
})) || [];

// Build unique locations for location cards from hardcoded data
const uniqueLocations = vpsLocations.map(location => ({
  locationName: location.city,
  regionName: location.region,
  flagIcon: location.flag,
  slug: location.slug,
  description: location.tagline,
  backgroundImageUrl: getBackgroundImage(location.city)
}));


// Features data with translations
const features = [
  {
    title: t.vps.index.features.ssdStorage.title,
    description: t.vps.index.features.ssdStorage.description,
    icon: "fas fa-bolt"
  },
  {
    title: t.vps.index.features.dedicatedResources.title,
    description: t.vps.index.features.dedicatedResources.description,
    icon: "fas fa-microchip"
  },
  {
    title: t.vps.index.features.rootAccess.title,
    description: t.vps.index.features.rootAccess.description,
    icon: "fas fa-terminal"
  },
  {
    title: t.vps.index.features.instantProvisioning.title,
    description: t.vps.index.features.instantProvisioning.description,
    icon: "fas fa-clock"
  },
  {
    title: t.vps.index.features.uptime.title,
    description: t.vps.index.features.uptime.description,
    icon: "fas fa-chart-line"
  },
  {
    title: t.vps.index.features.scalable.title,
    description: t.vps.index.features.scalable.description,
    icon: "fas fa-expand-arrows-alt"
  }
];
---

<Layout 
  title="VPS Hosting" 
  description="High-performance VPS hosting solutions with dedicated resources, SSD storage, and 99.9% uptime guarantee."
>
  <!-- Hero Section -->
  <Hero
    title={t.vps.index.hero.title}
    subtitle={t.vps.index.hero.subtitle}
    ctaText="View Pricing"
    ctaLink="#pricing"
    backgroundClass="bg-gradient-to-r from-primary-600 to-primary-800"
  />

  <!-- Locations -->
  <section class="py-12 bg-white border-b">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-center items-center gap-8 md:gap-16">
        <div class="flex items-center">
          <i class="fas fa-map-marker-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.vps.index.locations.globalLocations}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-tachometer-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.vps.index.locations.lowLatency}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-shield-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.vps.index.locations.enterpriseSecurity}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-16 md:py-24">
    <PricingTable
      title={t.vps.index.pricing.title}
      description={t.vps.index.pricing.description}
      plans={plans}
    />
  </section>

  <!-- All Available Locations Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{t.vps.index.allLocations.title}</h2>
        <p class="text-xl text-gray-600">{t.vps.index.allLocations.subtitle}</p>
      </div>

      {uniqueLocations.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {uniqueLocations.map(location => (
            <LocationCard
              locationName={location.locationName}
              regionName={location.regionName}
              flagIcon={location.flagIcon}
              slug={location.slug}
              description={location.description}
              backgroundImageUrl={location.backgroundImageUrl}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <div class="text-gray-400 text-6xl mb-4">
            <i class="fas fa-globe"></i>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">{t.vps.index.allLocations.comingSoon}</h3>
          <p class="text-gray-500">{t.vps.index.allLocations.comingSoonSubtitle}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Features -->
  <FeaturesSection
    title={t.vps.index.features.title}
    subtitle={t.vps.index.features.subtitle}
    features={features}
  />

  <!-- CTA Banner -->
  <CTABanner
    title={t.vps.index.cta.title}
    subtitle={t.vps.index.cta.subtitle}
    ctaText="Order Now"
    ctaLink="https://portal.qiwhost.com/login"
  />
</Layout>