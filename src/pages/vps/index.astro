---
import Layout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import PricingTable from '../../components/PricingTable.astro';
import CTABanner from '../../components/CTABanner.astro';
import LocationCard from '../../components/LocationCard.astro';
import { supabase } from '../../lib/supabase';

// Fetch only Linux VPS plans (3 plans)
const { data: linuxPlans, error: linuxError } = await supabase
  .from('hosting_plans')
  .select('*')
  .eq('category', 'VPS')
  .eq('visible', true)
  .eq('os_type', 'Linux')
  .order('sort_order', { ascending: true })
  .limit(3);

if (linuxError) {
  console.error('Error fetching Linux plans:', linuxError);
}

// Convert database plans to pricing table format
const plans = linuxPlans?.map(plan => ({
  name: plan.name,
  price: {
    monthly: `$${plan.price_monthly}`,
    yearly: `$${plan.price_yearly}`
  },
  description: `${plan.cpu}, ${plan.ram} RAM, ${plan.storage}`,
  features: [
    plan.cpu,
    plan.ram,
    plan.storage,
    plan.bandwidth,
    '24/7 Support',
    'Full Root Access'
  ],
  ctaText: "Order Now",
  ctaLink: plan.order_url,
  popular: plan.plan_type === 'Standard',
  sale_enabled: plan.sale_enabled,
  sale_price_monthly: plan.sale_price_monthly ? `$${plan.sale_price_monthly}` : undefined,
  sale_price_yearly: plan.sale_price_yearly ? `$${plan.sale_price_yearly}` : undefined,
  sale_badge_text: plan.sale_badge_text
})) || [];

// Fetch all unique VPS locations for the location cards
const { data: vpsLocations, error: locationsError } = await supabase
  .from('hosting_plans')
  .select('region, location, flag_icon, page_description')
  .eq('category', 'VPS')
  .eq('visible', true)
  .not('region', 'is', null)
  .not('location', 'is', null)
  .order('region', { ascending: true })
  .order('location', { ascending: true });

if (locationsError) {
  console.error('Error fetching VPS locations:', locationsError);
}

// Remove duplicates and create unique locations
const uniqueLocations = vpsLocations?.reduce((acc, location) => {
  const slug = location.location.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
  const exists = acc.find(l => l.slug === slug);
  if (!exists) {
    acc.push({
      locationName: location.location,
      regionName: location.region,
      flagIcon: location.flag_icon,
      slug,
      description: location.page_description
    });
  }
  return acc;
}, []) || [];

// Features data
const features = [
  {
    title: "High-Performance SSDs",
    description: "All VPS plans include SSD storage for faster data access and improved application performance.",
    icon: "fas fa-bolt"
  },
  {
    title: "Dedicated Resources",
    description: "Guaranteed CPU, RAM, and storage resources that are exclusively allocated to your VPS.",
    icon: "fas fa-microchip"
  },
  {
    title: "Full Root Access",
    description: "Complete control over your virtual server with root access and SSH capabilities.",
    icon: "fas fa-terminal"
  },
  {
    title: "Instant Provisioning",
    description: "Get your VPS up and running in minutes with our automated provisioning system.",
    icon: "fas fa-clock"
  },
  {
    title: "99.9% Uptime Guarantee",
    description: "Our robust infrastructure ensures your services remain online and accessible.",
    icon: "fas fa-chart-line"
  },
  {
    title: "Scalable Resources",
    description: "Easily upgrade your VPS resources as your business grows without any downtime.",
    icon: "fas fa-expand-arrows-alt"
  }
];
---

<Layout 
  title="VPS Hosting" 
  description="High-performance VPS hosting solutions with dedicated resources, SSD storage, and 99.9% uptime guarantee."
>
  <!-- Hero Section -->
  <Hero
    title="Virtual Private Server Hosting"
    subtitle="High-performance VPS solutions with dedicated resources and full root access."
    ctaText="View Pricing"
    ctaLink="#pricing"
    backgroundClass="bg-gradient-to-r from-primary-600 to-primary-800"
  />

  <!-- Locations -->
  <section class="py-12 bg-white border-b">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-center items-center gap-8 md:gap-16">
        <div class="flex items-center">
          <i class="fas fa-map-marker-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">Global Locations</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-tachometer-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">Low Latency Network</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-shield-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">Enterprise Security</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-16 md:py-24">
    <PricingTable
      title="Linux VPS Hosting Plans"
      description="Choose the perfect Linux VPS plan for your needs"
      plans={plans}
    />
  </section>

  <!-- All Available Locations Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">All Available Locations</h2>
        <p class="text-xl text-gray-600">Deploy your VPS in strategic locations worldwide for optimal performance</p>
      </div>

      {uniqueLocations.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {uniqueLocations.map(location => (
            <LocationCard
              locationName={location.locationName}
              regionName={location.regionName}
              flagIcon={location.flagIcon}
              slug={location.slug}
              description={location.description}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <div class="text-gray-400 text-6xl mb-4">
            <i class="fas fa-globe"></i>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">Locations Coming Soon</h3>
          <p class="text-gray-500">We're expanding our global network. Check back soon for more locations.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Features -->
  <FeaturesSection
    title="VPS Features"
    subtitle="Everything you need for a powerful virtual server experience"
    features={features}
  />

  <!-- CTA Banner -->
  <CTABanner
    title="Ready to Get Started?"
    subtitle="Launch your high-performance VPS today."
    ctaText="Order Now"
    ctaLink="/clientarea"
  />
</Layout>