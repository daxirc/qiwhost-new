---
import Layout from '../../../layouts/MainLayout.astro';
import Hero from '../../../components/Hero.astro';
import PricingTable from '../../../components/PricingTable.astro';
import CTABanner from '../../../components/CTABanner.astro';
import { supabase } from '../../../lib/supabase';
import { getTranslations, getCurrentLocale, getFlagImageUrl } from '../../../i18n/utils';

// Default city feature descriptions and icons (used when database doesn't provide them)
const cityFeatureDefaults = {
  "Low Latency Network": { description: "Optimized network infrastructure for minimal latency and maximum throughput.", icon: "fas fa-network-wired" },
  "Low Latency North Africa Access": { description: "Optimized routing for minimal latency across North Africa.", icon: "fas fa-tachometer-alt" },
  "Low Latency Africa Access": { description: "Optimized routing for minimal latency across Africa.", icon: "fas fa-tachometer-alt" },
  "Low Latency East Asia Access": { description: "Optimized routing for minimal latency across East Asia.", icon: "fas fa-tachometer-alt" },
