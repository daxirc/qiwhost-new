  "Low Latency UK Access": { description: "Optimized routing for minimal latency across the United Kingdom.", icon: "fas fa-tachometer-alt" },
  "Low Latency Eastern Europe Access": { description: "Optimized routing for minimal latency across Eastern Europe.", icon: "fas fa-tachometer-alt" },
  "Low Latency Iraq Access": { description: "Optimized routing for minimal latency across Iraq and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Gulf Access": { description: "Optimized routing for minimal latency across Gulf countries.", icon: "fas fa-tachometer-alt" },
  "Low Latency Qatar Access": { description: "Optimized routing for minimal latency across Qatar and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency UAE Access": { description: "Optimized routing for minimal latency across UAE and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Turkey Access": { description: "Optimized routing for minimal latency across Turkey and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Saudi Arabia Access": { description: "Optimized routing for minimal latency across Saudi Arabia and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Kuwait Access": { description: "Optimized routing for minimal latency across Kuwait and neighboring regions.", icon: "fas fa-tachometer-alt" },
