  "24/7 On-site Security": { description: "Round-the-clock physical security and monitoring.", icon: "fas fa-user-shield" },
  "Low Latency Asia Access": { description: "Optimized routing for minimal latency across Asia.", icon: "fas fa-tachometer-alt" }
