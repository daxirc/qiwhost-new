  "Low Latency US West Coast Access": { description: "Optimized routing for minimal latency across US West Coast and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency US East Coast Access": { description: "Optimized routing for minimal latency across US East Coast and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Australia Access": { description: "Optimized routing for minimal latency across Australia and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Colombia Access": { description: "Optimized routing for minimal latency across Colombia and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Argentina Access": { description: "Optimized routing for minimal latency across Argentina and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Chile Access": { description: "Optimized routing for minimal latency across Chile and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Brazil Access": { description: "Optimized routing for minimal latency across Brazil and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Bangladesh Access": { description: "Optimized routing for minimal latency across Bangladesh and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Pakistan Access": { description: "Optimized routing for minimal latency across Pakistan and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Nepal Access": { description: "Optimized routing for minimal latency across Nepal and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency India Access": { description: "Optimized routing for minimal latency across India and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Thailand Access": { description: "Optimized routing for minimal latency across Thailand and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Vietnam Access": { description: "Optimized routing for minimal latency across Vietnam and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Indonesia Access": { description: "Optimized routing for minimal latency across Indonesia and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Malaysia Access": { description: "Optimized routing for minimal latency across Malaysia and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Philippines Access": { description: "Optimized routing for minimal latency across Philippines and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Cambodia Access": { description: "Optimized routing for minimal latency across Cambodia and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Low Latency Myanmar Access": { description: "Optimized routing for minimal latency across Myanmar and neighboring regions.", icon: "fas fa-tachometer-alt" },
  "Enterprise-grade Infrastructure": { description: "State-of-the-art data centers with redundant power, cooling, and network systems.", icon: "fas fa-building" },
  "Multiple Datacenter Options": { description: "Choose from multiple data centers within the region for optimal performance.", icon: "fas fa-server" },
  "Tier-1 Network Providers": { description: "Direct connections to premium network providers for reliable connectivity.", icon: "fas fa-globe" },
  "Redundant Power Systems": { description: "Multiple power sources and backup generators ensure continuous operation.", icon: "fas fa-plug" },
  "Advanced Cooling Systems": { description: "Precision cooling systems maintain optimal operating temperatures for hardware.", icon: "fas fa-snowflake" },
  "GDPR Compliant": { description: "Infrastructure and processes designed to meet GDPR requirements.", icon: "fas fa-shield-alt" },
  "Green Energy Powered": { description: "Datacenter powered by renewable energy sources.", icon: "fas fa-leaf" },
  "24/7 On-site Security": { description: "Round-the-clock physical security and monitoring.", icon: "fas fa-user-shield" },
  "Low Latency Asia Access": { description: "Optimized routing for minimal latency across Asia.", icon: "fas fa-tachometer-alt" }
};

// Country name to flag emoji mapping
const countryNameToFlagEmoji = {
  'Germany': '🇩🇪',
  'Finland': '🇫🇮',
  'USA': '🇺🇸',
  'UK': '🇬🇧',
  'Singapore': '🇸🇬',
  'Japan': '🇯🇵',
  'India': '🇮🇳',
  'Australia': '🇦🇺'
};

export async function getStaticPaths() {
  // Define all locations with their regions and flag emojis
  const allLocations = [
    // Africa
    { location: 'Cairo', region: 'Africa', flag_icon: '🇪🇬' },
    { location: 'Johannesburg', region: 'Africa', flag_icon: '🇿🇦' },
    
    // East Asia
    { location: 'Hong Kong', region: 'East Asia', flag_icon: '🇭🇰' },
    { location: 'Seoul', region: 'East Asia', flag_icon: '🇰🇷' },
    { location: 'Taipei', region: 'East Asia', flag_icon: '🇹🇼' },
    { location: 'Tokyo', region: 'East Asia', flag_icon: '🇯🇵' },
    
    // Europe
    { location: 'Athens', region: 'Europe', flag_icon: '🇬🇷' },
    { location: 'Frankfurt', region: 'Europe', flag_icon: '🇩🇪' },
    { location: 'London', region: 'Europe', flag_icon: '🇬🇧' },
    { location: 'Marseille', region: 'Europe', flag_icon: '🇫🇷' },
    { location: 'Moscow', region: 'Europe', flag_icon: '🇷🇺' },
    { location: 'Sofia', region: 'Europe', flag_icon: '🇧🇬' },
    
    // Middle East
    { location: 'Baghdad', region: 'Middle East', flag_icon: '🇮🇶' },
    { location: 'Bahrain', region: 'Middle East', flag_icon: '🇧🇭' },
    { location: 'Doha', region: 'Middle East', flag_icon: '🇶🇦' },
    { location: 'Dubai', region: 'Middle East', flag_icon: '🇦🇪' },
    { location: 'Istanbul', region: 'Middle East', flag_icon: '🇹🇷' },
    { location: 'Jeddah', region: 'Middle East', flag_icon: '🇸🇦' },
    { location: 'Kuwait City', region: 'Middle East', flag_icon: '🇰🇼' },
    { location: 'Muscat', region: 'Middle East', flag_icon: '🇴🇲' },
    { location: 'Riyadh', region: 'Middle East', flag_icon: '🇸🇦' },
    
    // North America
    { location: 'Mexico City', region: 'North America', flag_icon: '🇲🇽' },
    { location: 'Silicon Valley', region: 'North America', flag_icon: '🇺🇸' },
    { location: 'Washington', region: 'North America', flag_icon: '🇺🇸' },
    
    // Oceania
    { location: 'Sydney', region: 'Oceania', flag_icon: '🇦🇺' },
    
    // South America
    { location: 'Bogota', region: 'South America', flag_icon: '🇨🇴' },
    { location: 'Buenos Aires', region: 'South America', flag_icon: '🇦🇷' },
    { location: 'Santiago', region: 'South America', flag_icon: '🇨🇱' },
    { location: 'São Paulo', region: 'South America', flag_icon: '🇧🇷' },
    
    // South Asia
    { location: 'Dhaka', region: 'South Asia', flag_icon: '🇧🇩' },
    { location: 'Karachi', region: 'South Asia', flag_icon: '🇵🇰' },
    { location: 'Kathmandu', region: 'South Asia', flag_icon: '🇳🇵' },
    { location: 'Mumbai', region: 'South Asia', flag_icon: '🇮🇳' },
    
    // Southeast Asia
    { location: 'Bangkok', region: 'Southeast Asia', flag_icon: '🇹🇭' },
    { location: 'Hanoi', region: 'Southeast Asia', flag_icon: '🇻🇳' },
    { location: 'Ho Chi Minh City', region: 'Southeast Asia', flag_icon: '🇻🇳' },
    { location: 'Jakarta', region: 'Southeast Asia', flag_icon: '🇮🇩' },
    { location: 'Kuala Lumpur', region: 'Southeast Asia', flag_icon: '🇲🇾' },
    { location: 'Manila', region: 'Southeast Asia', flag_icon: '🇵🇭' },
    { location: 'Phnom Penh', region: 'Southeast Asia', flag_icon: '🇰🇭' },
    { location: 'Yangon', region: 'Southeast Asia', flag_icon: '🇲🇲' }
  ];
  
  // Define countries that have dedicated VPS pages and should NOT be generated here
  const cloudVpsCountries = ['USA', 'UK', 'Germany', 'Finland', 'Singapore', 'Japan', 'India', 'Australia'];
  
  // Create paths for each location, excluding those covered by dedicated country pages
  const uniqueLocations = allLocations.filter(location => 
    !cloudVpsCountries.includes(location.location)
  ).map(location => ({
    slug: location.location.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, ''),
    location: location.location,
    region: location.region,
    flag_icon: location.flag_icon,
    page_description: ""
  }));

  // Generate paths for each location
  return uniqueLocations.map(location => ({
    params: { city: location.slug },
    props: { 
      cityName: location.location,
      region: location.region,
      flagIcon: location.flag_icon,
      pageDescription: location.page_description
    }
  }));
}

const { city } = Astro.params;
const { cityName, region, flagIcon, pageDescription } = Astro.props;

// Get translations for current locale
const locale = getCurrentLocale(Astro.currentLocale);
const t = getTranslations(locale);

// Fetch VPS plans for this specific city
const { data: cityPlans, error } = await supabase
  .from('hosting_plans')
  .select('*')
  .eq('category', 'VPS')
  .eq('location', cityName)
  .eq('visible', true)
  .order('sort_order', { ascending: true });

if (error) {
  console.error('Error fetching city plans:', error);
}

// Ensure we have at least 3 plans (Basic, Standard, Pro)
let processedPlans = cityPlans || [];

if (processedPlans.length > 0) {
  // Sort plans by plan_type to ensure consistent order
  processedPlans.sort((a, b) => {
    const planOrder = { 'Basic': 1, 'Standard': 2, 'Pro': 3 };
    return (planOrder[a.plan_type] || 99) - (planOrder[b.plan_type] || 99);
  });

  // Limit to 3 plans for display
  if (processedPlans.length > 3) {
    processedPlans = processedPlans.slice(0, 3);
  }
}

// Convert database plans to pricing table format
const plans = processedPlans.length > 0 ? processedPlans.map(plan => ({
  name: `${plan.plan_type || plan.name}`,
  price: {
    monthly: `$${plan.price_monthly}`,
    yearly: `$${plan.price_yearly}`
  },
  description: `${plan.cpu}, ${plan.ram} RAM, ${plan.storage}`,
  features: [
    plan.cpu,
    plan.ram,
    plan.storage,
    plan.bandwidth,
    ...(plan.plan_features || ['Full Root Access', '24/7 Support', 'SSD Storage'])
  ],
  ctaLink: plan.order_url,
  popular: plan.plan_type === 'Standard',
  sale_enabled: plan.sale_enabled,
  sale_price_monthly: plan.sale_price_monthly ? `$${plan.sale_price_monthly}` : undefined,
  sale_price_yearly: plan.sale_price_yearly ? `$${plan.sale_price_yearly}` : undefined,
  sale_badge_text: plan.sale_badge_text,
  osType: plan.os_type
})) : [];

// Features data with translations
const features = [
  {
    title: t.vpsLocations.features.ssdStorage.title,
    description: t.vpsLocations.features.ssdStorage.description,
    icon: "fas fa-bolt"
  },
  {
    title: t.vpsLocations.features.dedicatedResources.title,
    description: t.vpsLocations.features.dedicatedResources.description,
    icon: "fas fa-microchip"
  },
  {
    title: t.vpsLocations.features.rootAccess.title,
    description: t.vpsLocations.features.rootAccess.description,
    icon: "fas fa-terminal"
  },
  {
    title: t.vpsLocations.features.uptime.title,
    description: t.vpsLocations.features.uptime.description,
    icon: "fas fa-chart-line"
  },
  {
    title: t.vpsLocations.features.ddosProtection.title,
    description: t.vpsLocations.features.ddosProtection.description,
    icon: "fas fa-shield-alt"
  },
  {
    title: t.vpsLocations.features.support.title,
    description: t.vpsLocations.features.support.description,
    icon: "fas fa-headset"
  }
];

// Get city-specific features from the first plan
const citySpecificFeatures = processedPlans.length > 0 && processedPlans[0].city_features 
  ? processedPlans[0].city_features.filter(Boolean).map(feature => ({
      title: feature,
      description: cityFeatureDefaults[feature]?.description || "Premium feature for optimal performance.",
      icon: cityFeatureDefaults[feature]?.icon || "fas fa-star"
    }))
  : Object.entries(cityFeatureDefaults).slice(0, 6).map(([title, { description, icon }]) => ({
      title,
      description,
      icon
    }));

// Create translated strings with city name replacement
const heroTitle = t.vpsLocations.hero.title.replace('{cityName}', cityName);
const heroSubtitle = pageDescription || t.vpsLocations.hero.subtitle.replace('{cityName}', cityName);
const whyChooseTitle = t.vpsLocations.whyChoose.title.replace('{cityName}', cityName);
const whyChooseDescription = pageDescription || t.vpsLocations.whyChoose.description
  .replace('{cityName}', cityName)
  .replace('{cityName}', cityName);
const pricingTitle = t.vpsLocations.pricing.title.replace('{cityName}', cityName);
const ctaTitle = t.vpsLocations.cta.title.replace('{cityName}', cityName);
const locationInfo = t.vpsLocations.locationInfo.location.replace('{cityName}', cityName).replace('{region}', region);

const flagImageUrl = getFlagImageUrl(flagIcon);
---

<Layout 
  title={`${cityName} VPS Hosting`}
  description={`High-performance VPS hosting in ${cityName}, ${region}. ${pageDescription}`}
>
  <!-- Hero Section -->
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    ctaText="View Plans"
    ctaLink="#pricing"
    backgroundClass="bg-gradient-to-r from-primary-700 to-primary-900"
  />

  <!-- CTA Banner -->
  <section class="py-8 bg-white border-b">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-center items-center gap-8 md:gap-16">
        <div class="flex items-center">
          <i class="fas fa-map-marker-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{locationInfo}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-tachometer-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.vpsLocations.locationInfo.lowLatency}</span>
        </div>
        <div class="flex items-center">
          <i class="fas fa-shield-alt text-primary-500 text-2xl mr-2"></i>
          <span class="font-semibold">{t.vpsLocations.locationInfo.enterpriseSecurity}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Description Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {plans.length > 0 ? pricingTitle : "VPS Plans Coming Soon"}
        </h2>
        <p class="text-xl text-gray-600">
          {plans.length > 0 
            ? t.vpsLocations.pricing.description 
            : `We're expanding our infrastructure in ${cityName}. Check back soon for available plans.`}
        </p>
      </div>

      {plans.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
          {plans.map(plan => (
            <div class={`bg-white rounded-xl shadow-lg overflow-hidden transition-transform duration-300 hover:-translate-y-2 ${plan.popular ? 'border-2 border-primary-500 relative' : ''}`}>
              {(plan.popular || plan.sale_enabled) && (
                <div class={`${plan.sale_enabled ? 'bg-red-500' : 'bg-primary-500'} text-white text-sm font-semibold py-1 px-4 absolute top-0 right-0 rounded-bl-lg`}>
                  {plan.sale_enabled ? (plan.sale_badge_text || 'On Sale!') : 'Most Popular'}
                </div>
              )}
              <div class="p-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-2">{plan.name}</h3>
                {plan.osType && (
                  <div class="text-sm text-gray-500 mb-4 bg-gray-100 px-3 py-1 rounded-full inline-block">
                    {plan.osType}
                  </div>
                )}
                <div class="pricing-amount mb-6">
                  <div class="monthly-price">
                    {plan.sale_enabled ? (
                      <div>
                        <span class="text-4xl font-bold text-gray-900">{plan.sale_price_monthly}</span>
                        <span class="text-gray-600">/month</span>
                        <div class="text-sm mt-2">
                          <span class="line-through text-gray-400">{plan.price.monthly}</span>
                          <span class="text-red-600 ml-2 font-semibold">{plan.sale_badge_text}</span>
                        </div>
                      </div>
                    ) : (
                      <div>
                        <span class="text-4xl font-bold text-gray-900">{plan.price.monthly}</span>
                        <span class="text-gray-600">/month</span>
                      </div>
                    )}
                  </div>
                  <div class="yearly-price hidden">
                    {plan.sale_enabled && plan.sale_price_yearly ? (
                      <div>
                        <span class="text-4xl font-bold text-gray-900">{plan.sale_price_yearly}</span>
                        <span class="text-gray-600">/month</span>
                        <div class="text-sm mt-2">
                          <span class="line-through text-gray-400">{plan.price.yearly}</span>
                          <span class="text-red-600 ml-2 font-semibold">{plan.sale_badge_text}</span>
                        </div>
                        <p class="text-sm text-primary-600 mt-1">Billed annually</p>
                      </div>
                    ) : (
                      <div>
                        <span class="text-4xl font-bold text-gray-900">{plan.price.yearly}</span>
                        <span class="text-gray-600">/month</span>
                        <p class="text-sm text-primary-600 mt-1">Billed annually</p>
                      </div>
                    )}
                  </div>
                </div>
                <p class="text-gray-600 mb-6">{plan.description}</p>
                <ul class="space-y-3 mb-8">
                  {plan.features.map(feature => (
                    <li class="flex items-start">
                      <i class="fas fa-check text-primary-500 mr-3 mt-1"></i>
                      <span class="text-gray-700">{feature}</span>
                    </li>
                  ))}
                </ul>
                <a href={plan.ctaLink} class={`block text-center py-3 px-4 rounded-lg font-medium transition-colors ${plan.popular || plan.sale_enabled ? 'bg-primary-600 text-white hover:bg-primary-700' : 'border-2 border-primary-600 text-primary-600 hover:bg-primary-50'}`}>
                  Order Now
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-lg shadow-md">
          <div class="text-gray-400 text-6xl mb-4">
            <i class="fas fa-server"></i>
          </div>
          <h3 class="text-xl font-medium text-gray-900 mb-2">VPS Plans Coming Soon</h3>
          <p class="text-gray-600 max-w-lg mx-auto">
            We're currently expanding our infrastructure in {cityName}. 
            Check back soon for available VPS plans in this location.
          </p>
        </div>
      )}
    </div>
  </section>
  
  <!-- City-Specific Features -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {t.vpsLocations.features.title}
        </h2>
        <p class="text-xl text-gray-600">
          {t.vpsLocations.features.subtitle}
        </p>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-8 max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map(feature => (
            <div class="bg-gray-50 p-6 rounded-xl border border-gray-100">
              <div class="bg-primary-100 text-primary-600 rounded-full w-14 h-14 flex items-center justify-center mb-4">
                <i class={`${feature.icon} text-2xl`}></i>
              </div>
              <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
              <p class="text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- City-Specific Features -->
  {citySpecificFeatures.length > 0 && (
    <section class="py-16 md:py-24 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{cityName} Datacenter Features</h2>
          <p class="text-xl text-gray-600">Our {cityName} datacenter provides enterprise-grade infrastructure for your applications</p>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-8 max-w-6xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {citySpecificFeatures.map(feature => (
              <div class="bg-gray-50 p-6 rounded-xl border border-gray-100">
                <div class="bg-primary-100 text-primary-600 rounded-full w-14 h-14 flex items-center justify-center mb-4">
                  <i class={`${feature.icon} text-2xl`}></i>
                </div>
                <h3 class="text-xl font-semibold mb-3">{feature.title}</h3>
                <p class="text-gray-600">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
  
  <!-- CTA Banner -->
  <CTABanner
    title={ctaTitle}
    subtitle={t.vpsLocations.cta.subtitle}
    ctaText="Order Now"
    ctaLink="https://portal.qiwhost.com/login"
  />
</Layout>

<script>
  // Pricing toggle functionality
  document.addEventListener('DOMContentLoaded', function() {
    const pricingToggle = document.getElementById('pricing-toggle');
    if (!pricingToggle) return; // Exit if toggle doesn't exist
    
    const monthlyPrices = document.querySelectorAll('.monthly-price');
    const yearlyPrices = document.querySelectorAll('.yearly-price');
    
    pricingToggle.addEventListener('change', function() {
      if (this.checked) {
        monthlyPrices.forEach(el => el.classList.add('hidden'));
        yearlyPrices.forEach(el => el.classList.remove('hidden'));
      } else {
        monthlyPrices.forEach(el => el.classList.remove('hidden'));
        yearlyPrices.forEach(el => el.classList.add('hidden'));
      }
    });
  });
</script>