      "Windows Server (OS)",
      "Jede Anwendung und jedes Programm installieren",
      "Mehrere VPS-Standorte"
    ],
    ctaText: "Jetzt starten",
    ctaLink: "https://portal.qiwhost.com/cart.php?a=add&pid=166"
  }
];

// Features
const forexFeatures = [
  {
    title: "Netzwerk mit geringer Latenz",
    description: "Führen Sie Trades in Millisekunden aus. Unsere Server befinden sich strategisch in der Nähe der wichtigsten Broker-Rechenzentren für die geringstmögliche Latenz.",
    icon: "fas fa-network-wired"
  },
  {
    title: "Bereit für Windows Server",
    description: "Vollständig lizenzierte Windows Server-Umgebungen sind vorinstalliert und bieten eine vertraute Desktop-Benutzeroberfläche, auf die über Remote Desktop (RDP) zugegriffen werden kann.",
    icon: "fab fa-windows"
  },
  {
    title: "MT4 & MT5 kompatibel",
    description: "Perfekt optimiert für die Ausführung von MetaTrader 4, MetaTrader 5, cTrader und anderen wichtigen Forex-Handelsplattformen ohne jegliche Einschränkungen.",
    icon: "fas fa-chart-line"
  },
  {
    title: "Unterbrechungsfreie Uptime 24/7",
    description: "Lassen Sie nicht zu, dass lokale Internet- oder Stromausfälle Ihre Trades stoppen. Unsere Rechenzentren bieten eine Verfügbarkeitsgarantie von 99,99%.",
