---
import Layout from '../../layouts/MainLayout.astro';
---

<Layout title="Reset Password - Admin Panel" noIndex={true}>
  
  <div id="admin-reset-root">
    <div class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
      <div class="max-w-md w-full">
        <!-- Logo and Title -->
        <div class="text-center mb-8">
          <h1 class="text-4xl font-bold text-primary-600 mb-2">QIW HOST</h1>
          <p class="text-gray-600">Admin Dashboard</p>
        </div>

        <!-- Reset Password Form Card -->
        <div class="bg-white rounded-xl shadow-xl p-8 space-y-6">
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-100 mb-4">
              <i class="fas fa-key text-2xl text-primary-600"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-900">Reset Your Password</h2>
            <p class="text-gray-600 mt-1">Enter your new password below</p>
          </div>

          <form id="resetPasswordForm" class="space-y-5">
            <div>
              <label for="newPassword" class="block text-sm font-medium text-gray-700 mb-1">
                New Password
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="fas fa-lock text-gray-400"></i>
                </div>
                <input
                  type="password"
                  id="newPassword"
                  name="newPassword"
                  required
                  minlength="6"
                  class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                  placeholder="••••••••"
                />
              </div>
            </div>

            <div>
              <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">
                Confirm New Password
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="fas fa-lock text-gray-400"></i>
                </div>
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  required
                  minlength="6"
                  class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                  placeholder="••••••••"
                />
              </div>
            </div>

            <div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
            </div>

            <div id="successMessage" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
            </div>

            <button
              type="submit"
              id="submitButton"
              class="w-full bg-primary-600 text-white py-2.5 px-4 rounded-lg hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors duration-200 flex items-center justify-center"
            >
              <i class="fas fa-save mr-2"></i>
              Update Password
            </button>
          </form>

          <div class="text-center">
            <a href="/admin" class="text-primary-600 hover:text-primary-500 font-medium text-sm">
              <i class="fas fa-arrow-left mr-1"></i>
              Back to Login
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* Hide the entire fixed header container (includes both top bar and navigation) */
  body:has(#admin-reset-root) .fixed.w-full.top-0.z-50 {
    display: none !important;
  }
  
  /* Remove support section and footer for admin */
  body:has(#admin-reset-root) footer,
  body:has(#admin-reset-root) section:not(:first-child) {
    display: none !important;
  }

  /* Ensure admin panel takes full height */
  body:has(#admin-reset-root) main {
    min-h: 100vh !important;
    padding: 0 !important;
  }
  
  /* Reset any top padding from main layout */
  body:has(#admin-reset-root) main {
    padding-top: 0 !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('resetPasswordForm');
    const errorMessage = document.getElementById('errorMessage');

    // Show message that password reset is handled by admin
    errorMessage.textContent = 'Password reset is handled by your system administrator. Please contact them to update your password.';
    errorMessage.classList.remove('hidden');

    if (form) {
      form.style.display = 'none';
    }
  });
</script>